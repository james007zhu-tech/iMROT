// DCiT OS — data model
// One rule governs everything here: every business record can answer "which asset is this about".
// Modules: Admin · ALM · CRM · OPD · SLM · SCM · T&O · FIN. Phase 1 builds Admin, ALM, CRM, OPD, SLM in full
// and only the slices of SCM / T&O / FIN that one service order needs (OBTH, TITH, IVTH, payment).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Admin ─────────────────────────

/// A legal entity = one company in one country. Country code (TH / VN / CN) is what appears in every number.
model LegalEntity {
  id                String    @id @default(cuid())
  countryCode       String    @unique /// TH, VN, CN — used verbatim in ATH / CTH / ETH / QTTH …
  code              String    @unique @default("DCiT") /// DCiT / DCiV / DCiC (default only so existing databases upgrade with db push) — what people pick in "所属法人"
  nameEn            String
  nameLocal         String?
  brand             String    @default("DCiT")
  taxId             String?
  branchCode        String? /// Thailand: 00000 = head office
  addressEn         String?
  addressLocal      String?
  phone             String?
  email             String?
  website           String?
  signatoryName     String? /// used only where a template demands a signature line
  localCurrency     String /// THB for TH — tax invoices are issued in this currency
  bookCurrency      String    @default("CNY") /// accounting currency for the whole group
  vatRate           Decimal   @default(0.07) @db.Decimal(5, 4)
  bankDetails       Json? /// bank, branch, swift, accounts by currency
  vatRegisteredFrom DateTime? /// printed in the tax-invoice footer (ภ.พ.20 effective date)
  createdAt         DateTime  @default(now())

  employees     Employee[]
  customers     Customer[]
  assets        Asset[]
  sequences     DocSequence[]
  serviceOrders ServiceOrder[]
  documents     Document[]
}

/// Daily Bank of China exchange rates. One row per currency per publish date; `rateToCny` = 中行折算价 per 1 unit.
model FxRate {
  id          String    @id @default(cuid())
  rateDate    DateTime  @db.Date
  currency    String /// ISO code: THB, USD, VND …
  rateToCny   Decimal   @db.Decimal(18, 8)
  buyRemit    Decimal?  @db.Decimal(18, 6) /// 现汇买入价 per 100 units, kept for audit
  sellRemit   Decimal?  @db.Decimal(18, 6) /// 现汇卖出价 per 100 units
  source      String    @default("BOC")
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())

  @@unique([rateDate, currency, source])
  @@index([currency, rateDate])
}

/// Running counters behind every number. One row per (entity, prefix, period).
/// Prefix examples: A, C, E (monthly) · QT, IN, RP, IB, OB … (daily).
model DocSequence {
  id       String      @id @default(cuid())
  entityId String
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  prefix   String /// "A" | "C" | "E" | "QT" | "RP" | …
  period   String /// "2611" for monthly, "261102" for daily
  last     Int         @default(0)

  @@unique([entityId, prefix, period])
}

// ───────────────────────── OPD (employees only — customer contacts and trainees are not numbered) ─────────────────────────

enum EmployeeRole {
  MD /// managing director — the only role that sees OPD (employees) and legal entities
  ADMIN
  MANAGER
  ENGINEER
  SALES
  FINANCE
  WAREHOUSE
}

model Employee {
  id           String       @id @default(cuid())
  code         String       @unique /// ETH2610001 — the first letter+country of this code decides the country of everything this person creates
  entityId     String
  entity       LegalEntity  @relation(fields: [entityId], references: [id])
  name         String
  nameLocal    String?
  role         EmployeeRole
  email        String?      @unique
  phone        String?
  passwordHash String?
  locale       String       @default("th") /// th | zh | en — UI language, switchable any time
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  lastLoginAt  DateTime?

  // ── ETH employee file (2026-11-08): the MD sees and edits everything; the person sees their own file
  //    without salary and may change their own contact details. Contacts are masked until the password is re-entered.
  nationality       String?
  birthDate         DateTime?
  gender            String? /// M | F | other, as the person states it
  position          String? /// job title as used on site, independent of the system role
  managerId         String?
  manager           Employee?     @relation("Manager", fields: [managerId], references: [id])
  reports           Employee[]    @relation("Manager")
  joinedAt          DateTime?
  probationEndsAt   DateTime?
  confirmedAt       DateTime? /// passed probation
  contractType      ContractType?
  contractEndsAt    DateTime?
  workLocation      String?
  leftAt            DateTime?
  leftReason        String?
  phone2            String? /// second mobile (home country)
  lineId            String?
  wechatId          String?
  personalEmail     String?
  address           String?
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  bankName          String? /// payroll account
  bankAccount       String?
  ssoNo             String? /// social security number
  taxNo             String? /// personal tax ID
  attachments       Json? /// archived originals: CV, contract, ID copies — [{name,url,kind}]

  careers     EmployeeCareer[]
  credentials EmployeeCredential[]
  salaries    SalaryRecord[]       @relation("SalaryOf")
  reviews     PerformanceReview[]  @relation("ReviewOf")

  assetsResponsible Asset[]             @relation("AssetResponsible")
  events            AssetEvent[]
  ordersAssigned    ServiceOrder[]      @relation("OrderAssignee")
  ordersCreated     ServiceOrder[]      @relation("OrderCreator")
  inspections       Inspection[]
  repairJobs        RepairJob[]
  documents         Document[]
  dashboards        Dashboard[]
  auditLogs         AuditLog[]
  deliveries        DeliveryNote[]
  marginApprovals   ServiceOrder[]      @relation("MarginApprover")
  inquiries         PurchaseInquiry[]   @relation("InquiryRequester")
  purchaseOrders    PurchaseOrder[]     @relation("PoCreator")
  salariesApproved  SalaryRecord[]      @relation("SalaryApprover")
  salariesCreated   SalaryRecord[]      @relation("SalaryCreator")
  reviewsGiven      PerformanceReview[] @relation("Reviewer")
}

enum ContractType {
  PROBATION
  FIXED_TERM
  PERMANENT
  CONTRACTOR
}

/// Work history, from the CV (source AI) or typed (MANUAL). Periods as YYYY-MM; open end = current.
model EmployeeCareer {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromYm     String
  toYm       String?
  company    String
  title      String?
  summary    String? /// main work and skills
  source     String   @default("MANUAL") /// AI | MANUAL
  sort       Int      @default(0)

  @@index([employeeId, fromYm])
}

enum CredentialKind {
  PASSPORT
  ID_CARD
  VISA
  WORK_PERMIT
  REPORT_90 /// 90-day report to immigration
  CONTRACT
  DEGREE
  CERTIFICATE /// licences and trade certificates, e.g. high-voltage electrician
  DRIVING_LICENCE
  OTHER
}

/// Documents with a number and an expiry: the list page turns orange `remindDays` before `expiresAt`.
model EmployeeCredential {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       CredentialKind
  title      String? /// free title for DEGREE / CERTIFICATE / OTHER
  number     String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  remindDays Int            @default(90)
  file       Json? /// {name,url,kind}
  note       String?

  @@index([employeeId, expiresAt])
}

/// One row per salary version, effective from a date; the current salary is the latest effective row.
/// This is the accountant's basis for payroll (decision 2026-11-08): gross structure, SSO base and rates,
/// provident fund, personal tax deductions and the estimated monthly withholding. MD only; every view is audited.
model SalaryRecord {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation("SalaryOf", fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom   DateTime
  currency        String   @default("THB")
  baseSalary      Decimal  @db.Decimal(14, 2)
  allowances      Json? /// [{name, amount, taxable}] — position, housing, transport, phone, meal …
  allowanceTotal  Decimal  @default(0) @db.Decimal(14, 2)
  grossMonthly    Decimal  @db.Decimal(14, 2) /// baseSalary + allowanceTotal
  ssoWageBase     Decimal? @db.Decimal(14, 2) /// wage used for social security, capped by law
  ssoEmployeeRate Decimal? @db.Decimal(6, 4) /// e.g. 0.05
  ssoEmployerRate Decimal? @db.Decimal(6, 4)
  ssoEmployee     Decimal? @db.Decimal(14, 2) /// monthly employee contribution
  ssoEmployer     Decimal? @db.Decimal(14, 2)
  pvdEmployeeRate Decimal? @db.Decimal(6, 4) /// provident fund
  pvdEmployerRate Decimal? @db.Decimal(6, 4)
  taxDeductions   Json? /// personal allowances declared to the accountant: {maritalStatus, children, parents, lifeInsurance, …}
  whtMonthly      Decimal? @db.Decimal(14, 2) /// estimated monthly withholding (ภ.ง.ด.1); accountant's figure
  otherDeductions Json? /// [{name, amount}]
  netEstimate     Decimal? @db.Decimal(14, 2) /// gross − ssoEmployee − pvd − wht − other; indicative only
  reason          String /// hire, confirmation, annual review, promotion …
  note            String?
  approvedById    String
  approvedBy      Employee @relation("SalaryApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime @default(now())
  createdById     String
  createdBy       Employee @relation("SalaryCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  attachments     Json? /// offer letter, salary memo

  @@index([employeeId, effectiveFrom])
}

enum ReviewKind {
  PROBATION
  QUARTERLY
  ANNUAL
  SPECIAL
}

/// Performance review: the MD records period, score, grade and conclusion; the HQ self-assessment form is attached.
model PerformanceReview {
  id                String     @id @default(cuid())
  employeeId        String
  employee          Employee   @relation("ReviewOf", fields: [employeeId], references: [id], onDelete: Cascade)
  period            String /// "2026 Q3", "2025-12 probation"
  kind              ReviewKind
  score             Decimal?   @db.Decimal(5, 1)
  grade             String? /// A / B+ / PASS …
  reviewerId        String
  reviewer          Employee   @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewedAt        DateTime
  conclusion        String?
  improvements      String?
  visibleToEmployee Boolean    @default(true)
  attachments       Json?
  createdAt         DateTime   @default(now())

  @@index([employeeId, reviewedAt])
}

/// Who looked at or changed sensitive things: revealing contacts, creating/changing employees, overriding a delivery check.
model AuditLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  actorId String
  actor   Employee @relation(fields: [actorId], references: [id])
  action  String /// CONTACT_REVEAL | EMPLOYEE_CREATE | EMPLOYEE_UPDATE | DELIVERY_OVERRIDE | ENTITY_UPDATE …
  target  String /// CTH2611001 / ETH2611004 / DNTH26110601
  detail  Json?

  @@index([target, at])
}

// ───────────────────────── CRM ─────────────────────────

model Customer {
  id                String      @id @default(cuid())
  code              String      @unique /// CTH2610001
  entityId          String
  entity            LegalEntity @relation(fields: [entityId], references: [id])
  name              String
  nameLocal         String?
  taxId             String?
  branchCode        String?
  addressEn         String?
  addressLocal      String?
  phone             String?
  billingAddress    String?
  registeredCapital Decimal?    @db.Decimal(18, 2)
  foundedAt         DateTime?
  dbdStatus         String? /// as DBD reports it, e.g. ยังดำเนินกิจการอยู่
  dbdFetchedAt      DateTime?
  dbdData           Json? /// raw lookup result, kept for audit
  editedFields      Json? /// fields a person changed after the DBD lookup
  files             Json? /// [{name, url, kind: DBD | PP20 | BILLING}] — the only documents accepted at onboarding
  paymentTermDays   Int         @default(30)
  monthlyStatement  Boolean     @default(false) /// true = 月结客户, gets a BLTH every month
  defaultCurrency   String      @default("THB")
  locale            String      @default("th")
  notes             String?
  createdAt         DateTime    @default(now())

  plants        Plant[]
  contacts      Contact[]
  assets        Asset[]
  serviceOrders ServiceOrder[]
  documents     Document[]
}

/// A customer's factory. The smallest unit an asset belongs to.
model Plant {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  code        String /// P1, P2 — unique within the customer
  name        String
  address     String?
  accessNotes String? /// gate pass, PPE, escort requirements

  assets        Asset[]
  contacts      Contact[]
  serviceOrders ServiceOrder[]

  @@unique([customerId, code])
}

/// Customer-side people. Not numbered (decision 2026-11-02). May have a portal login.
model Contact {
  id                 String   @id @default(cuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  plantId            String?
  plant              Plant?   @relation(fields: [plantId], references: [id])
  name               String
  title              String?
  phone              String?
  email              String?
  lineId             String?
  portalLogin        String?  @unique
  portalPasswordHash String?
  locale             String   @default("th")

  reportedOrders ServiceOrder[]
  acceptances    Acceptance[]
}

// ───────────────────────── ALM — product knowledge: brand → series → model ─────────────────────────

model Brand {
  id     String   @id @default(cuid())
  code   String   @unique /// SIE
  name   String /// SIEMENS
  series Series[]
  parts  Part[]
}

model Series {
  id      String  @id @default(cuid())
  brandId String
  brand   Brand   @relation(fields: [brandId], references: [id])
  code    String /// S120
  name    String /// SINAMICS S120
  notes   String? /// structure, shared fault-code system, shared maintenance standards live here

  models               Model[]
  faultCodes           FaultCode[]
  maintenanceStandards MaintenanceStandard[]

  @@unique([brandId, code])
}

enum LifecycleStatus {
  ACTIVE
  MATURE
  DISCONTINUED
}

model Model {
  id              String          @id @default(cuid())
  seriesId        String
  series          Series          @relation(fields: [seriesId], references: [id])
  code            String /// vendor's own model string, verbatim: 6SL3120-2TE41-0AA1
  ratedPowerKw    Decimal?        @db.Decimal(10, 2)
  ratedVoltageV   Int?
  ratedCurrentA   Decimal?        @db.Decimal(10, 2)
  overloadClass   String?
  controlMode     String?
  lifecycle       LifecycleStatus @default(ACTIVE)
  replacedBy      String? /// successor model code if discontinued
  designLifeYears Int?
  specs           Json?
  documents       Json? /// manuals, drawings: [{title, url, kind}]

  assets               Asset[]
  bom                  ModelPart[]
  faultCodes           FaultCode[]
  maintenanceStandards MaintenanceStandard[]

  @@unique([seriesId, code])
}

model ModelPart {
  id       String  @id @default(cuid())
  modelId  String
  model    Model   @relation(fields: [modelId], references: [id])
  partId   String
  part     Part    @relation(fields: [partId], references: [id])
  qty      Int     @default(1)
  position String? /// e.g. "control board", "fan 1"

  @@unique([modelId, partId, position])
}

/// Fault codes live at series level; a model-level row overrides the series row for that model only.
model FaultCode {
  id          String  @id @default(cuid())
  seriesId    String
  series      Series  @relation(fields: [seriesId], references: [id])
  modelId     String?
  model       Model?  @relation(fields: [modelId], references: [id])
  code        String /// F30001
  title       String
  meaning     String?
  firstChecks String? /// what an engineer checks first — reviewed by the technical lead
  reviewed    Boolean @default(false)

  @@index([seriesId, code])
}

model MaintenanceStandard {
  id             String  @id @default(cuid())
  seriesId       String
  series         Series  @relation(fields: [seriesId], references: [id])
  modelId        String?
  model          Model?  @relation(fields: [modelId], references: [id])
  item           String /// "clean heatsink", "replace fan", "DC-link capacitor check"
  intervalHours  Int?
  intervalMonths Int?
  criterion      String?
  reviewed       Boolean @default(false)
}

// ───────────────────────── ALM — the single asset ─────────────────────────

enum AssetType {
  VFD
  MOTOR
  PLC
  PANEL
  DRIVE_TRAIN
  SENSOR
  OTHER
}

enum AssetStatus {
  ONBOARDED /// 建档 / 接管
  IN_SERVICE /// 在役运行
  MAINTENANCE /// 维护保养
  REPAIR /// 故障维修
  OVERHAUL /// 系统性检修 / 改造
  ACCEPTANCE /// 测试与验收
  SPARE /// 备用库 / 共享备机
  RETIRED /// 退役 / 替换
}

enum AssetOrigin {
  NEW_INSTALL
  TAKEOVER
}

/// One physical machine = one ATH number = one serial number, for life.
/// Transfers between customers change customerId / plantId / location and write an event; the ATH never changes.
model Asset {
  id                  String      @id @default(cuid())
  code                String      @unique /// ATH26100001
  entityId            String
  entity              LegalEntity @relation(fields: [entityId], references: [id])
  type                AssetType
  modelId             String?
  model               Model?      @relation(fields: [modelId], references: [id])
  serialNumber        String /// vendor's S/N verbatim — the true identity
  customerAssetNo     String? /// the customer's own tag, if any
  customerId          String?
  customer            Customer?   @relation(fields: [customerId], references: [id])
  plantId             String?
  plant               Plant?      @relation(fields: [plantId], references: [id])
  location            String? /// workshop / line / position text
  status              AssetStatus @default(ONBOARDED)
  origin              AssetOrigin @default(TAKEOVER)
  installedAt         DateTime?
  responsibleId       String?
  responsible         Employee?   @relation("AssetResponsible", fields: [responsibleId], references: [id])
  configuration       Json? /// options, brake unit, filter, encoder …
  operatingConditions Json? /// load type, running hours/day, dust, temperature, grid, cooling
  nameplatePhoto      String?
  photos              Json?
  qrPrintedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  events           AssetEvent[]
  relationsFrom    AssetRelation[]     @relation("RelFrom")
  relationsTo      AssetRelation[]     @relation("RelTo")
  parameterBackups ParameterBackup[]
  readings         AssetReading[]
  orderLinks       ServiceOrderAsset[]
  inspections      Inspection[]
  repairJobs       RepairJob[]
  stockMovements   StockMovement[]

  @@unique([serialNumber, modelId])
  @@index([customerId, status])
}

enum AssetRelationType {
  DRIVES /// VFD → motor
  INSTALLED_IN /// VFD → panel
  CONTROLLED_BY /// VFD → PLC
  COUPLED_TO /// motor → gearbox / drive train
}

model AssetRelation {
  id          String            @id @default(cuid())
  fromAssetId String
  fromAsset   Asset             @relation("RelFrom", fields: [fromAssetId], references: [id])
  toAssetId   String
  toAsset     Asset             @relation("RelTo", fields: [toAssetId], references: [id])
  relation    AssetRelationType
  validFrom   DateTime          @default(now())
  validTo     DateTime?

  @@index([fromAssetId])
  @@index([toAssetId])
}

enum AssetEventType {
  ONBOARDED
  CONDITION_RECORDED
  PARAMETER_BACKUP
  TRANSFERRED /// customer / plant / location changed
  RELATION_CHANGED
  SERVICE_REQUESTED /// QTTH created
  INSPECTED /// INTH
  QUOTED
  ORDER_CONFIRMED
  MAINTAINED /// PMTH
  REPAIRED /// RPTH
  OVERHAULED
  PART_REPLACED /// from OBTH
  RECEIVED_WORKSHOP /// ERTH
  DELIVERED /// DNTH signed by the customer
  TESTED
  ACCEPTED
  INVOICED
  PAID
  READING
  ALARM
  CASE_ARCHIVED
  STATUS_CHANGED
  RETIRED
}

/// The "前世今生": an append-only stream. Everything else is a view over it.
model AssetEvent {
  id             String         @id @default(cuid())
  assetId        String
  asset          Asset          @relation(fields: [assetId], references: [id])
  type           AssetEventType
  occurredAt     DateTime       @default(now())
  actorId        String?
  actor          Employee?      @relation(fields: [actorId], references: [id])
  actorName      String? /// for customer-side actors (not numbered)
  serviceOrderId String?
  serviceOrder   ServiceOrder?  @relation(fields: [serviceOrderId], references: [id])
  sourceDocNo    String? /// INTH…, RPTH…, OBTH…, TITH…
  summary        String /// one line, human-readable
  payload        Json? /// measurements, values, before/after
  attachments    Json? /// [{name, url}]
  createdAt      DateTime       @default(now())

  @@index([assetId, occurredAt])
  @@index([serviceOrderId])
}

model ParameterBackup {
  id      String   @id @default(cuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id])
  takenAt DateTime @default(now())
  fileUrl String
  note    String?
  byName  String?
}

/// Runtime layer (Phase 3). Table exists so Phase 1 code can write manual inspection readings into it.
model AssetReading {
  id      String   @id @default(cuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id])
  at      DateTime @default(now())
  metric  String /// output_hz, output_a, dc_bus_v, heatsink_c, run_hours …
  value   Decimal  @db.Decimal(18, 4)
  source  String   @default("MANUAL") /// MANUAL | GATEWAY

  @@index([assetId, metric, at])
}

// ───────────────────────── SLM — one service = one QTTH ─────────────────────────

enum ServiceOrderStatus {
  RECEIVED /// 已受理 — QTTH draft created at report time
  ASSIGNED /// 已派工
  DIAGNOSING /// 诊断中
  QUOTE_PENDING /// 待确认报价
  IN_PROGRESS /// 执行中
  ACCEPTANCE_PENDING /// 待验收
  ACCEPTED /// 已验收
  INVOICED /// 已开票
  CLOSED /// 已完成
  CANCELLED
}

/// Quote margin against the 50 % floor: NOT_NEEDED (at or above), PENDING (below, waiting for the MD), APPROVED, REJECTED.
enum MarginApproval {
  NOT_NEEDED
  PENDING
  APPROVED
  REJECTED
}

enum ServiceKind {
  REPAIR
  MAINTENANCE
  OVERHAUL
  CONTRACT /// in-contract work: QTTH still created, amount 0 or contract price
  PARTS_SALE
}

model ServiceOrder {
  id                 String             @id @default(cuid())
  no                 String             @unique /// QTTH26110201
  entityId           String
  entity             LegalEntity        @relation(fields: [entityId], references: [id])
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id])
  plantId            String?
  plant              Plant?             @relation(fields: [plantId], references: [id])
  kind               ServiceKind        @default(REPAIR)
  status             ServiceOrderStatus @default(RECEIVED)
  reportedSymptom    String?
  reportedAlarm      String?
  productionImpact   String?
  reportedById       String?
  reportedBy         Contact?           @relation(fields: [reportedById], references: [id])
  reportedAt         DateTime           @default(now())
  assigneeId         String?
  assignee           Employee?          @relation("OrderAssignee", fields: [assigneeId], references: [id])
  createdById        String
  createdBy          Employee           @relation("OrderCreator", fields: [createdById], references: [id])
  customerRef        String? /// customer's own order number, verbatim (e.g. XCGDD2610140001)
  poLines            Json? /// the customer PO, line by line: [{lineNo, description, qty, unit, isService}] — delivery notes are checked against it
  attachments        Json? /// [{name, url, kind: PO | REPORT_MSG | PHOTO}] — originals kept for later comparison
  currency           String             @default("THB")
  fxRateToCny        Decimal?           @db.Decimal(18, 8)
  subtotal           Decimal?           @db.Decimal(18, 2)
  vatAmount          Decimal?           @db.Decimal(18, 2)
  total              Decimal?           @db.Decimal(18, 2)
  totalCny           Decimal?           @db.Decimal(18, 2)
  quoteSentAt        DateTime?
  quoteConfirmedAt   DateTime?
  closedAt           DateTime?
  // ── margin gate (流程图: 毛利率不低于 50%，否则 MD 审批) ──
  costTotal          Decimal?           @db.Decimal(18, 2) /// sum of line qty × unitCost, order currency
  marginPct          Decimal?           @db.Decimal(6, 4) /// (subtotal − costTotal) / subtotal
  marginApproval     MarginApproval     @default(NOT_NEEDED)
  marginApprovedById String?
  marginApprovedBy   Employee?          @relation("MarginApprover", fields: [marginApprovedById], references: [id])
  marginApprovedAt   DateTime?
  marginNote         String?
  // ── acceptance lock (流程图: 验收后锁定成本与价格，不再新增 PR/PO) ──
  lockedAt           DateTime?
  lockedById         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assets         ServiceOrderAsset[]
  lines          QuoteLine[]
  inspections    Inspection[]
  repairJobs     RepairJob[]
  acceptance     Acceptance?
  events         AssetEvent[]
  documents      Document[]
  stockMovements StockMovement[]
  taxInvoices    TaxInvoice[]
  invoices       Invoice[]
  deliveries     DeliveryNote[]
  inquiries      PurchaseInquiry[]
  purchaseOrders PurchaseOrder[]

  @@index([customerId, status])
}

model ServiceOrderAsset {
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  assetId        String
  asset          Asset        @relation(fields: [assetId], references: [id])
  isPrimary      Boolean      @default(true)

  @@id([serviceOrderId, assetId])
}

model QuoteLine {
  id               String       @id @default(cuid())
  serviceOrderId   String
  serviceOrder     ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  lineNo           Int
  assetCode        String? /// every line carries the asset it is for
  partId           String?
  part             Part?        @relation(fields: [partId], references: [id])
  description      String
  descriptionLocal String? /// Thai text required on tax invoices
  qty              Decimal      @db.Decimal(12, 3)
  unit             String       @default("pcs")
  unitPrice        Decimal      @db.Decimal(18, 2)
  amount           Decimal      @db.Decimal(18, 2)
  costRef          Decimal?     @db.Decimal(18, 2) /// last purchase cost shown to sales, not to customer
  unitCost         Decimal?     @db.Decimal(18, 2) /// cost used for the margin: entered, or the part's last cost / purchase comparison

  @@unique([serviceOrderId, lineNo])
}

/// INTH — one inspection of one asset. Feeds template 08 Diagnostic Report.
model Inspection {
  id             String          @id @default(cuid())
  no             String          @unique /// INTH26110201
  serviceOrderId String
  serviceOrder   ServiceOrder    @relation(fields: [serviceOrderId], references: [id])
  assetId        String
  asset          Asset           @relation(fields: [assetId], references: [id])
  engineerId     String
  engineer       Employee        @relation(fields: [engineerId], references: [id])
  inspectedAt    DateTime        @default(now())
  symptoms       String?
  conditions     String?
  findings       String?
  probableCause  String?
  recommendation String?
  tests          Json? /// [{test, criterion, result, recordId}]
  instruments    String?
  openIssues     String?
  conclusion     String?
  attachments    Json?
  location       RepairLocation? /// where it was inspected: SITE or WORKSHOP
  attachmentRefs String? /// photo / record IDs referred to in the evidence table (P1–P3, M1 …)
  needs          Json? /// internal only, never printed (rule 21): [{kind PART|LABOUR, partSku?, vendorPartNo?, description, descriptionLocal?, qty, unit, onHand?, short?}] — saved for real → stock checked, short parts raise a PRTH (flow step 3)
  draft          Boolean         @default(false) /// "save draft": number reserved, but no document, event or status change until saved for real
}

enum RepairKind {
  MAINTENANCE
  REPAIR
  OVERHAUL
  FIELD_SERVICE
}

enum RepairLocation {
  SITE
  WORKSHOP
}

/// RPTH (and PMTH when kind = MAINTENANCE). Feeds templates 09 / 10 / 11.
model RepairJob {
  id              String         @id @default(cuid())
  no              String         @unique /// RPTH26110201 or PMTH26110201
  serviceOrderId  String
  serviceOrder    ServiceOrder   @relation(fields: [serviceOrderId], references: [id])
  assetId         String
  asset           Asset          @relation(fields: [assetId], references: [id])
  engineerId      String
  engineer        Employee       @relation(fields: [engineerId], references: [id])
  kind            RepairKind
  location        RepairLocation @default(SITE)
  startedAt       DateTime?
  finishedAt      DateTime?
  confirmedFault  String?
  rootCause       String?
  workPerformed   String?
  partsReplaced   Json? /// [{partSku, qty, oldSerial, newSerial, obthNo}]
  configBackupRef String?
  laborHours      Decimal?       @db.Decimal(8, 2)
  tests           Json? /// [{test, criterion, result, pass}]
  openIssues      String?
  conclusion      String?
  attachments     Json?
  // ── PMTH only (kind = MAINTENANCE) ──
  level           String? /// QUARTERLY | HALF_YEAR | ANNUAL | CONTRACT
  runHours        Int? /// cumulative running hours at this visit
  checklist       Json? /// [{item, criterion, measured, verdict: OK | HANDLED | HAZARD | WATCH, photo}]
  hazards         String? /// what was found and not yet fixed — the real deliverable of maintenance
  handled         String? /// what was fixed on this visit
  recommendation  String?
  conditionRating String? /// GOOD | GOOD_WITH_ISSUE | POOR
  nextDueAt       DateTime?
  nextDueHours    Int?
  consumables     String? /// PMTH: consumables / parts used (stock-out brings them in)
  escortContactId String? /// PMTH: the customer's person on site (a Contact; masked wherever shown)
  // ── RPTH ──
  travelCost      Decimal?       @db.Decimal(14, 2) /// travel / other costs, in the order's currency
}

enum AcceptanceStatus {
  ACCEPTED
  CONDITIONAL
  REJECTED
}

/// Template 12 (service completion) is the engineer's record; template 13 (customer acceptance) is this row signed.
model Acceptance {
  id                String           @id @default(cuid())
  serviceOrderId    String           @unique
  serviceOrder      ServiceOrder     @relation(fields: [serviceOrderId], references: [id])
  deliverables      Json /// [{deliverable, criterion, result}]
  punchList         String?
  status            AcceptanceStatus
  acceptedAt        DateTime?
  warrantyStart     DateTime?
  warrantyTerms     String?
  customerContactId String?
  customerContact   Contact?         @relation(fields: [customerContactId], references: [id])
  customerSignatory String?
  signatureUrl      String?
  dcitSignatory     String?
}

// ───────────────────────── SCM (Phase 1 slice) ─────────────────────────

model Part {
  id               String   @id @default(cuid())
  sku              String   @unique /// SIE-6SL3120... = <brand>-<vendor part no>
  brandId          String?
  brand            Brand?   @relation(fields: [brandId], references: [id])
  vendorPartNo     String
  name             String
  nameLocal        String?
  unit             String   @default("pcs")
  lastCost         Decimal? @db.Decimal(18, 2)
  lastCostCurrency String?
  substitutes      Json? /// [sku, …]
  safetyStock      Int?

  bomLines   ModelPart[]
  quoteLines QuoteLine[]
  movements  StockMovement[]
}

enum MovementDirection {
  IN /// IBTH
  OUT /// OBTH
}

model StockMovement {
  id                 String            @id @default(cuid())
  no                 String /// IBTH261102001 / OBTH261102001 — one number per document; the document may hold several SKUs
  lineNo             Int               @default(1) /// each line moves exactly one SKU
  direction          MovementDirection
  partId             String
  part               Part              @relation(fields: [partId], references: [id])
  qty                Decimal           @db.Decimal(12, 3)
  warehouse          String            @default("RAYONG")
  batch              String?
  assetId            String? /// OUT: which machine it went into
  asset              Asset?            @relation(fields: [assetId], references: [id])
  serviceOrderId     String?
  serviceOrder       ServiceOrder?     @relation(fields: [serviceOrderId], references: [id])
  oldPartDisposition String? /// where the removed part went
  movedAt            DateTime          @default(now())
  byName             String?
  unitCost           Decimal?          @db.Decimal(18, 2) /// IN: cost of this line (also updates Part.lastCost)
  supplierRef        String? /// IN: supplier's delivery / invoice number, verbatim
  purchaseOrderId    String? /// IN: the POTH this receipt fulfils
  purchaseOrder      PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])

  @@unique([no, lineNo])
}

// ───────────────────────── SCM purchasing (流程图: PRTH 询价比价 → POTH 采购 → IBTH 到货) ─────────────────────────

/// Suppliers — master data numbered like customers: STH + YYMM + 3-digit serial (decided 2026-11-08).
model Supplier {
  id           String   @id @default(cuid())
  code         String?  @unique /// STH2611001 — optional only so databases with suppliers from before 2026-11-08 can upgrade; db:seed numbers them, new ones always get one
  entityId     String?
  name         String
  nameLocal    String?
  taxId        String?  @unique
  branchCode   String?  @default("00000")
  contactName  String?
  phone        String?
  email        String?
  address      String?
  currency     String   @default("THB")
  paymentTerms String?
  leadTimeDays Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  quotes SupplierQuote[]
  orders PurchaseOrder[]
}

enum InquiryStatus {
  OPEN /// sent to suppliers, waiting for quotes
  COMPARED /// a quote was selected — costs flow back into the QTTH
  ORDERED /// a POTH was raised from it
  CANCELLED
}

/// PRTH — one purchase inquiry (one or more lines) sent to one or more suppliers; their quotes are compared here.
model PurchaseInquiry {
  id             String        @id @default(cuid())
  no             String        @unique /// PRTH26110701
  entityId       String
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  status         InquiryStatus @default(OPEN)
  requestedById  String
  requestedBy    Employee      @relation("InquiryRequester", fields: [requestedById], references: [id])
  neededBy       DateTime?
  note           String?
  lines          Json /// [{lineNo, partSku?, vendorPartNo?, description, qty, unit, assetCode?}]
  attachments    Json?
  createdAt      DateTime      @default(now())

  quotes SupplierQuote[]
  orders PurchaseOrder[]

  @@index([serviceOrderId])
}

/// One supplier's answer to a PRTH (usually read from their quotation PDF). `selected` wins the comparison.
model SupplierQuote {
  id           String          @id @default(cuid())
  inquiryId    String
  inquiry      PurchaseInquiry @relation(fields: [inquiryId], references: [id])
  supplierId   String
  supplier     Supplier        @relation(fields: [supplierId], references: [id])
  quoteNo      String? /// supplier's number, verbatim
  quoteDate    DateTime?
  validUntil   DateTime?
  currency     String          @default("THB")
  vatRate      Decimal?        @db.Decimal(5, 4)
  subtotal     Decimal         @db.Decimal(18, 2)
  total        Decimal?        @db.Decimal(18, 2)
  leadTimeDays Int?
  paymentTerms String?
  lines        Json /// [{lineNo, vendorPartNo?, description, qty, unit, unitPrice, amount}] — lineNo matches the inquiry line
  attachments  Json?
  selected     Boolean         @default(false)
  createdAt    DateTime        @default(now())

  @@index([inquiryId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL /// some lines received (IBTH)
  RECEIVED
  CANCELLED
}

/// POTH — what we order from a supplier; receipts (IBTH) post against its lines until it is RECEIVED.
model PurchaseOrder {
  id             String              @id @default(cuid())
  no             String              @unique /// POTH26110701
  entityId       String
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  inquiryId      String?
  inquiry        PurchaseInquiry?    @relation(fields: [inquiryId], references: [id])
  serviceOrderId String?
  serviceOrder   ServiceOrder?       @relation(fields: [serviceOrderId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  orderedAt      DateTime            @default(now())
  expectedAt     DateTime?
  currency       String              @default("THB")
  fxRateToCny    Decimal?            @db.Decimal(18, 8)
  subtotal       Decimal             @db.Decimal(18, 2)
  vatRate        Decimal             @db.Decimal(5, 4)
  vatAmount      Decimal             @db.Decimal(18, 2)
  total          Decimal             @db.Decimal(18, 2)
  totalCny       Decimal?            @db.Decimal(18, 2)
  supplierRef    String? /// supplier's order confirmation / invoice number, verbatim
  paymentTerms   String?
  lines          Json /// [{lineNo, partSku?, vendorPartNo?, description, qty, unit, unitPrice, amount, receivedQty}]
  attachments    Json?
  createdById    String
  createdBy      Employee            @relation("PoCreator", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())

  receipts StockMovement[]

  @@index([serviceOrderId])
}

// ───────────────────────── T&O / FIN (Phase 1 slice) ─────────────────────────

/// TITH — Thai tax invoice: local currency, Thai description, VAT as a separate line.
model TaxInvoice {
  id             String       @id @default(cuid())
  no             String       @unique /// TITH26110201
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  issuedAt       DateTime
  currency       String /// THB in Thailand, by law
  lines          Json /// [{descriptionLocal, descriptionEn, qty, unitPrice, amount}]
  subtotal       Decimal      @db.Decimal(18, 2)
  vatRate        Decimal      @db.Decimal(5, 4)
  vatAmount      Decimal      @db.Decimal(18, 2)
  total          Decimal      @db.Decimal(18, 2)
  fxRateToCny    Decimal      @db.Decimal(18, 8)
  totalCny       Decimal      @db.Decimal(18, 2)
  buyerTaxId     String?
  buyerBranch    String?
  voidedAt       DateTime? /// voided numbers are kept, never reused
  voidReason     String?

  invoices Invoice[]
}

/// IVTH — the Invoice the customer pays against; also serves as the payment record (no separate receipt).
model Invoice {
  id             String            @id @default(cuid())
  no             String            @unique /// IVTH26110201
  serviceOrderId String
  serviceOrder   ServiceOrder      @relation(fields: [serviceOrderId], references: [id])
  taxInvoiceId   String?
  taxInvoice     TaxInvoice?       @relation(fields: [taxInvoiceId], references: [id])
  issuedAt       DateTime
  dueAt          DateTime?
  currency       String
  amountDue      Decimal           @db.Decimal(18, 2)
  paidAmount     Decimal?          @db.Decimal(18, 2)
  whtAmount      Decimal?          @db.Decimal(18, 2) /// tax withheld by the customer
  whtCertRef     String? /// customer's withholding certificate reference
  paidAt         DateTime?
  bankRef        String?
  statementId    String?
  statement      MonthlyStatement? @relation(fields: [statementId], references: [id])
  attachments    Json? /// customer's payment proofs: [{name, url, kind: PAYMENT_PROOF | WHT_CERT}]

  receipts Receipt[]
}

/// RCTH — ใบเสร็จรับเงิน, one per payment received against an IVTH (decided 2026-11-07). Records this
/// payment's cash, withholding and settled amount, the bank reference and the original tax invoice; never recomputes VAT.
model Receipt {
  id            String   @id @default(cuid())
  no            String   @unique /// RCTH26110701
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  taxInvoiceNo  String? /// original TITH, printed on the receipt
  receivedAt    DateTime /// actual date the money arrived
  currency      String
  cashAmount    Decimal  @db.Decimal(18, 2)
  whtAmount     Decimal  @db.Decimal(18, 2)
  settledAmount Decimal  @db.Decimal(18, 2) /// cash + WHT
  bankRef       String?
  whtCertRef    String?
  attachments   Json?
  createdAt     DateTime @default(now())
}

/// BLTH — monthly statement for credit customers: the list of IVTH due this month.
model MonthlyStatement {
  id         String    @id @default(cuid())
  no         String    @unique /// BLTH26113001
  customerId String
  period     String /// 2611
  issuedAt   DateTime
  currency   String
  total      Decimal   @db.Decimal(18, 2)
  invoices   Invoice[]
}

// ───────────────────────── Documents registry ─────────────────────────

enum DocType {
  QT // quotation / service order
  PR // purchase inquiry
  PO // purchase order
  IN // inspection
  RP // repair
  PM // preventive maintenance record
  ER // equipment receiving
  TI // tax invoice
  IV // invoice
  BL // monthly statement
  PF // proforma invoice
  IB // stock in
  OB // stock out
  DN // delivery note (DNTH) — decided 2026-11-03
  CN // credit note
  DB // debit note
  TF // spare transfer
  RT // return
  SC // service contract
  PV // payment voucher
  TR // training
  RC // receipt (RCTH) — decided 2026-11-07
}

/// Every issued number is registered here once, whatever table holds the detail. Voided rows stay.
enum DeliveryStatus {
  DRAFT
  ISSUED /// checked against the PO and printed
  SIGNED /// customer signed for it
}

/// DNTH — what physically goes back to the customer. Every PO line must match; what came in on the ERTH and
/// old parts marked "return to customer" on the RPTH must go back too. Template 19.
model DeliveryNote {
  id             String         @id @default(cuid())
  no             String         @unique /// DNTH26110601
  serviceOrderId String
  serviceOrder   ServiceOrder   @relation(fields: [serviceOrderId], references: [id])
  status         DeliveryStatus @default(DRAFT)
  deliverOn      DateTime
  plantId        String?
  address        String?
  contactId      String?
  driverId       String?
  driver         Employee?      @relation(fields: [driverId], references: [id])
  vehicle        String?
  lines          Json /// [{kind: PO | RETURN, poLineNo?, description, assetCode?, partSku?, expected, delivered, source?}]
  mismatch       Json? /// what did not match when it was issued
  overrideReason String? /// MD approval to issue despite a mismatch
  overrideById   String?
  signedBy       String?
  signedAt       DateTime?
  signatureUrl   String?
  attachments    Json? /// archived with the DN: our signed copy (DELIVERY) and, when the customer insists on their own form, their delivery note (CUSTOMER_DN, optional)
  remark         String?
  createdAt      DateTime       @default(now())
}

model Document {
  id             String        @id @default(cuid())
  no             String        @unique
  type           DocType
  entityId       String
  entity         LegalEntity   @relation(fields: [entityId], references: [id])
  countryCode    String
  issuedAt       DateTime      @default(now())
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  createdById    String
  createdBy      Employee      @relation(fields: [createdById], references: [id])
  templateCode   String? /// 04 … 13 — which Word template renders it
  pdfUrl         String?
  voidedAt       DateTime?
  voidReason     String?

  @@index([type, issuedAt])
}

// ───────────────────────── Dashboards (built by people or by the AI assistant) ─────────────────────────

/// A dashboard is a JSON spec of widgets over the metric catalog in src/lib/metrics.ts — never raw SQL.
model Dashboard {
  id        String    @id @default(cuid())
  name      String
  ownerId   String?
  owner     Employee? @relation(fields: [ownerId], references: [id])
  spec      Json /// { widgets: [{ metric, chart, w, params }] }
  isShared  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
