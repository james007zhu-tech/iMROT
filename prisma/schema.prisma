// DCiT OS — data model
// One rule governs everything here: every business record can answer "which asset is this about".
// Modules: Admin · ALM · CRM · OPD · SLM · SCM · T&O · FIN. Phase 1 builds Admin, ALM, CRM, OPD, SLM in full
// and only the slices of SCM / T&O / FIN that one service order needs (OBTH, TITH, IVTH, payment).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Admin ─────────────────────────

/// A legal entity = one company in one country. Country code (TH / VN / CN) is what appears in every number.
model LegalEntity {
  id                 String    @id @default(cuid())
  countryCode        String    @unique /// TH, VN, CN — used verbatim in ATH / CTH / ETH / QTTH …
  code               String    @unique @default("DCiT") /// DCiT / DCiV / DCiC (default only so existing databases upgrade with db push) — what people pick in "所属法人"
  nameEn             String
  nameLocal          String?
  brand              String    @default("DCiT")
  taxId              String?
  branchCode         String? /// Thailand: 00000 = head office
  addressEn          String?
  addressLocal       String?
  phone              String?
  email              String?
  website            String?
  signatoryName      String? /// used only where a template demands a signature line
  localCurrency      String /// THB for TH — tax invoices are issued in this currency
  bookCurrency       String    @default("CNY") /// accounting currency for the whole group
  vatRate            Decimal   @default(0.07) @db.Decimal(5, 4)
  bankDetails        Json? /// bank, branch, swift, accounts by currency
  vatRegisteredFrom  DateTime? /// printed in the tax-invoice footer (ภ.พ.20 effective date)
  taxInvoiceBookSize Int       @default(50) /// tax invoices per เล่ม (book); books are numbered consecutively per entity (朱总 2026-11-08)
  createdAt          DateTime  @default(now())

  employees     Employee[]
  customers     Customer[]
  assets        Asset[]
  sequences     DocSequence[]
  serviceOrders ServiceOrder[]
  documents     Document[]
}

/// Daily Bank of China exchange rates. One row per currency per publish date; `rateToCny` = 中行折算价 per 1 unit.
model FxRate {
  id          String    @id @default(cuid())
  rateDate    DateTime  @db.Date
  currency    String /// ISO code: THB, USD, VND …
  rateToCny   Decimal   @db.Decimal(18, 8)
  buyRemit    Decimal?  @db.Decimal(18, 6) /// 现汇买入价 per 100 units, kept for audit
  sellRemit   Decimal?  @db.Decimal(18, 6) /// 现汇卖出价 per 100 units
  source      String    @default("BOC")
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())

  @@unique([rateDate, currency, source])
  @@index([currency, rateDate])
}

/// Running counters behind every number. One row per (entity, prefix, period).
/// Prefix examples: A, C, E (monthly) · QT, IN, RP, IB, OB … (daily).
model DocSequence {
  id       String      @id @default(cuid())
  entityId String
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  prefix   String /// "A" | "C" | "E" | "QT" | "RP" | …
  period   String /// "2611" for monthly, "261102" for daily
  last     Int         @default(0)

  @@unique([entityId, prefix, period])
}

// ───────────────────────── OPD (employees only — customer contacts and trainees are not numbered) ─────────────────────────

enum EmployeeRole {
  MD /// managing director — the only role that sees OPD (employees) and legal entities
  ADMIN
  MANAGER
  ENGINEER
  SALES
  FINANCE
  WAREHOUSE
}

model Employee {
  id           String       @id @default(cuid())
  code         String       @unique /// ETH2610001 — the first letter+country of this code decides the country of everything this person creates
  entityId     String
  entity       LegalEntity  @relation(fields: [entityId], references: [id])
  name         String
  nameLocal    String?
  role         EmployeeRole
  email        String?      @unique
  phone        String?
  passwordHash String?
  shortcuts    Json? /// 常用功能: the entry keys this person pinned (src/lib/nav.ts SHORTCUTS); null = the role's default
  locale       String       @default("th") /// th | zh | en — UI language, switchable any time
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  lastLoginAt  DateTime?

  // ── ETH employee file (2026-11-08): the MD sees and edits everything; the person sees their own file
  //    without salary and may change their own contact details. Contacts are masked until the password is re-entered.
  nationality       String?
  birthDate         DateTime?
  gender            String? /// M | F | other, as the person states it
  position          String? /// job title as used on site, independent of the system role
  managerId         String?
  manager           Employee?     @relation("Manager", fields: [managerId], references: [id])
  reports           Employee[]    @relation("Manager")
  joinedAt          DateTime?
  probationEndsAt   DateTime?
  confirmedAt       DateTime? /// passed probation
  contractType      ContractType?
  contractEndsAt    DateTime?
  workLocation      String?
  leftAt            DateTime?
  leftReason        String?
  phone2            String? /// second mobile (home country)
  lineId            String?
  wechatId          String?
  personalEmail     String?
  address           String?
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  bankName          String? /// payroll account
  bankAccount       String?
  ssoNo             String? /// social security number
  taxNo             String? /// personal tax ID
  attachments       Json? /// archived originals: CV, contract, ID copies — [{name,url,kind}]

  careers         EmployeeCareer[]
  credentials     EmployeeCredential[]
  salaries        SalaryRecord[]       @relation("SalaryOf")
  reviews         PerformanceReview[]  @relation("ReviewOf")
  overtime        OvertimeRequest[]    @relation("OvertimeOf")
  overtimeDecided OvertimeRequest[]    @relation("OvertimeApprover")
  overtimeLines   OvertimePayLine[]
  expenses        ExpenseClaim[]       @relation("ExpenseOf")
  expensesDecided ExpenseClaim[]       @relation("ExpenseApprover")
  trainings       TrainingRecord[]
  payrollLines    PayrollLine[]
  salesTargets    SalesTarget[]

  assetsResponsible  Asset[]                @relation("AssetResponsible")
  events             AssetEvent[]
  ordersAssigned     ServiceOrder[]         @relation("OrderAssignee")
  ordersCreated      ServiceOrder[]         @relation("OrderCreator")
  ordersSold         ServiceOrder[]         @relation("OrderSales")
  quoteDeclines      QuoteDecline[]
  inspections        Inspection[]
  repairJobs         RepairJob[]
  documents          Document[]
  dashboards         Dashboard[]
  auditLogs          AuditLog[]
  deliveries         DeliveryNote[]
  marginApprovals    ServiceOrder[]         @relation("MarginApprover")
  inquiries          PurchaseInquiry[]      @relation("InquiryRequester")
  purchaseOrders     PurchaseOrder[]        @relation("PoCreator")
  milestones         SubcontractMilestone[] @relation("MilestoneBy")
  supplierRatings    SupplierRating[]       @relation("RatingBy")
  salariesApproved   SalaryRecord[]         @relation("SalaryApprover")
  salariesCreated    SalaryRecord[]         @relation("SalaryCreator")
  reviewsGiven       PerformanceReview[]    @relation("Reviewer")
  faultCodesReviewed FaultCode[]            @relation("FaultCodeReviewer")
  faultCodeImports   FaultCodeImport[]
  publishRuns        PublishRun[]
}

enum ContractType {
  PROBATION
  FIXED_TERM
  PERMANENT
  CONTRACTOR
}

/// Work history, from the CV (source AI) or typed (MANUAL). Periods as YYYY-MM; open end = current.
model EmployeeCareer {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromYm     String
  toYm       String?
  company    String
  title      String?
  summary    String? /// main work and skills
  source     String   @default("MANUAL") /// AI | MANUAL
  sort       Int      @default(0)

  @@index([employeeId, fromYm])
}

enum CredentialKind {
  PASSPORT
  ID_CARD
  VISA
  WORK_PERMIT
  REPORT_90 /// 90-day report to immigration
  CONTRACT
  DEGREE
  CERTIFICATE /// licences and trade certificates, e.g. high-voltage electrician
  DRIVING_LICENCE
  OTHER
}

/// Documents with a number and an expiry: the list page turns orange `remindDays` before `expiresAt`.
model EmployeeCredential {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       CredentialKind
  title      String? /// free title for DEGREE / CERTIFICATE / OTHER
  number     String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  remindDays Int            @default(90)
  file       Json? /// {name,url,kind}
  note       String?

  @@index([employeeId, expiresAt])
}

/// One row per salary version, effective from a date; the current salary is the latest effective row.
/// This is the accountant's basis for payroll (decision 2026-11-08): gross structure, SSO base and rates,
/// provident fund, personal tax deductions and the estimated monthly withholding. MD only; every view is audited.
model SalaryRecord {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation("SalaryOf", fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom   DateTime
  currency        String   @default("THB")
  baseSalary      Decimal  @db.Decimal(14, 2)
  allowances      Json? /// [{name, amount, taxable}] — position, housing, transport, phone, meal …
  allowanceTotal  Decimal  @default(0) @db.Decimal(14, 2)
  grossMonthly    Decimal  @db.Decimal(14, 2) /// baseSalary + allowanceTotal
  quarterlyPay    Decimal? @db.Decimal(14, 2) /// 季度绩效: the amount per month at 100 %; three months of it are paid with the quarter's last payroll
  variablePay     Decimal? @db.Decimal(14, 2) /// 绩效工资: the monthly amount at 100 % performance; payroll multiplies it by the month's factor
  ssoWageBase     Decimal? @db.Decimal(14, 2) /// wage used for social security, capped by law
  ssoEmployeeRate Decimal? @db.Decimal(6, 4) /// e.g. 0.05
  ssoEmployerRate Decimal? @db.Decimal(6, 4)
  ssoEmployee     Decimal? @db.Decimal(14, 2) /// monthly employee contribution
  ssoEmployer     Decimal? @db.Decimal(14, 2)
  pvdEmployeeRate Decimal? @db.Decimal(6, 4) /// provident fund
  pvdEmployerRate Decimal? @db.Decimal(6, 4)
  taxDeductions   Json? /// personal allowances declared to the accountant: {maritalStatus, children, parents, lifeInsurance, …}
  whtMonthly      Decimal? @db.Decimal(14, 2) /// estimated monthly withholding (ภ.ง.ด.1); accountant's figure
  otherDeductions Json? /// [{name, amount}]
  netEstimate     Decimal? @db.Decimal(14, 2) /// gross − ssoEmployee − pvd − wht − other; indicative only
  reason          String /// hire, confirmation, annual review, promotion …
  note            String?
  approvedById    String
  approvedBy      Employee @relation("SalaryApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime @default(now())
  createdById     String
  createdBy       Employee @relation("SalaryCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  attachments     Json? /// offer letter, salary memo
  letter          Json? /// 调薪通知单 details: {salutation, position, praiseTh, praiseEn, praiseZh} — template 32

  @@index([employeeId, effectiveFrom])
}

enum ReviewKind {
  MONTHLY /// 月度绩效: period "2026-11", score 0–100 — feeds that month's payroll
  PROBATION
  QUARTERLY
  ANNUAL
  SPECIAL
}

/// Performance review: the MD records period, score, grade and conclusion; the HQ self-assessment form is attached.
model PerformanceReview {
  id                String     @id @default(cuid())
  employeeId        String
  employee          Employee   @relation("ReviewOf", fields: [employeeId], references: [id], onDelete: Cascade)
  period            String /// "2026 Q3", "2025-12 probation"
  kind              ReviewKind
  score             Decimal?   @db.Decimal(5, 1)
  grade             String? /// A / B+ / PASS …
  reviewerId        String
  reviewer          Employee   @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewedAt        DateTime
  conclusion        String?
  improvements      String?
  visibleToEmployee Boolean    @default(true)
  attachments       Json?
  createdAt         DateTime   @default(now())

  @@index([employeeId, reviewedAt])
}

/// Who looked at or changed sensitive things: revealing contacts, creating/changing employees, overriding a delivery check.
model AuditLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  actorId String
  actor   Employee @relation(fields: [actorId], references: [id])
  action  String /// CONTACT_REVEAL | EMPLOYEE_CREATE | EMPLOYEE_UPDATE | DELIVERY_OVERRIDE | ENTITY_UPDATE …
  target  String /// CTH2611001 / ETH2611004 / DNTH26110601
  detail  Json?

  @@index([target, at])
}

// ───────────────────────── CRM ─────────────────────────

model Customer {
  id                String      @id @default(cuid())
  code              String      @unique /// CTH2610001
  entityId          String
  entity            LegalEntity @relation(fields: [entityId], references: [id])
  name              String
  nameLocal         String?
  taxId             String?
  branchCode        String?
  addressEn         String?
  addressLocal      String?
  phone             String?
  billingAddress    String?
  registeredCapital Decimal?    @db.Decimal(18, 2)
  foundedAt         DateTime?
  dbdStatus         String? /// as DBD reports it, e.g. ยังดำเนินกิจการอยู่
  dbdFetchedAt      DateTime?
  dbdData           Json? /// raw lookup result, kept for audit
  editedFields      Json? /// fields a person changed after the DBD lookup
  files             Json? /// [{name, url, kind: DBD | PP20 | BILLING}] — the only documents accepted at onboarding
  paymentTermDays   Int         @default(30)
  monthlyStatement  Boolean     @default(false) /// true = 月结客户, gets a BLTH every month
  defaultCurrency   String      @default("THB")
  locale            String      @default("th")
  notes             String?
  createdAt         DateTime    @default(now())

  plants        Plant[]
  contacts      Contact[]
  assets        Asset[]
  serviceOrders ServiceOrder[]
  documents     Document[]
}

/// A customer's factory. The smallest unit an asset belongs to.
model Plant {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  code        String /// P1, P2 — unique within the customer
  name        String
  address     String?
  accessNotes String? /// gate pass, PPE, escort requirements

  assets        Asset[]
  contacts      Contact[]
  serviceOrders ServiceOrder[]

  @@unique([customerId, code])
}

/// Customer-side people. Not numbered (decision 2026-11-02). May have a portal login.
model Contact {
  id                 String   @id @default(cuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  plantId            String?
  plant              Plant?   @relation(fields: [plantId], references: [id])
  name               String
  title              String?
  phone              String?
  email              String?
  lineId             String?
  birthday           String? /// "MM-DD" — the message centre reminds the account owner a week ahead (朱总 2026-11-10)
  portalLogin        String?  @unique
  portalPasswordHash String?
  locale             String   @default("th")

  reportedOrders ServiceOrder[]
  acceptances    Acceptance[]
  quoteDeclines  QuoteDecline[]
}

// ───────────────────────── ALM — product knowledge: brand → series → model ─────────────────────────

/// Data dictionary (朱总 2026-11-09/10, docs/mockups/equipment-knowledge-v0.1.html): brands and series are edited on
/// /series; a brand or series is hidden (active=false), never deleted — machines on file keep showing it.
model Brand {
  id        String   @id @default(cuid())
  code      String   @unique /// SIE
  name      String /// SIEMENS
  slug      String?  @unique /// public URL part: siemens
  website   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(100)
  series    Series[]
  parts     Part[]
}

/// 产品类别 — dictionary: VFD, PLC, SERVO_DRIVE, SERVO_MOTOR, MOTOR, HMI, SOFT_STARTER, OTHER (editable).
model ProductCategory {
  code      String   @id
  nameTh    String
  nameZh    String
  nameEn    String
  sortOrder Int      @default(100)
  series    Series[]
}

model Series {
  id            String           @id @default(cuid())
  brandId       String
  brand         Brand            @relation(fields: [brandId], references: [id])
  code          String /// S120
  name          String /// SINAMICS S120
  notes         String? /// structure, shared fault-code system, shared maintenance standards live here
  slug          String? /// public URL part, unique per brand: sinamics-s120
  categoryCode  String?
  category      ProductCategory? @relation(fields: [categoryCode], references: [code])
  lifecycle     LifecycleStatus  @default(ACTIVE)
  successorId   String? /// the series that replaces a discontinued one
  successor     Series?          @relation("SeriesSuccessor", fields: [successorId], references: [id])
  predecessors  Series[]         @relation("SeriesSuccessor")
  aliases       String[]         @default([])
  codePattern   String? /// regex the series' fault codes follow, e.g. ^[FA]\d{5}$ (S120), ^[0-9A-F]{4}$ (ACS880)
  codeRule      String? /// the same in words, for people and the AI
  documents     Json? /// manuals: [{title, docId, revision, date, url, sha256}]
  publicVisible Boolean          @default(true) /// shown on the public site when it has published codes
  active        Boolean          @default(true)

  models               Model[]
  faultCodes           FaultCode[]
  maintenanceStandards MaintenanceStandard[]

  @@unique([brandId, code])
  @@unique([brandId, slug])
}

enum LifecycleStatus {
  ACTIVE
  MATURE
  DISCONTINUED
}

model Model {
  id              String          @id @default(cuid())
  seriesId        String
  series          Series          @relation(fields: [seriesId], references: [id])
  code            String /// vendor's own model string, verbatim: 6SL3120-2TE41-0AA1
  ratedPowerKw    Decimal?        @db.Decimal(10, 2)
  ratedVoltageV   Int?
  ratedCurrentA   Decimal?        @db.Decimal(10, 2)
  overloadClass   String?
  controlMode     String?
  lifecycle       LifecycleStatus @default(ACTIVE)
  replacedBy      String? /// successor model code if discontinued
  designLifeYears Int?
  specs           Json?
  documents       Json? /// manuals, drawings: [{title, url, kind}]

  assets               Asset[]
  bom                  ModelPart[]
  faultCodes           FaultCode[]
  maintenanceStandards MaintenanceStandard[]

  @@unique([seriesId, code])
}

model ModelPart {
  id       String  @id @default(cuid())
  modelId  String
  model    Model   @relation(fields: [modelId], references: [id])
  partId   String
  part     Part    @relation(fields: [partId], references: [id])
  qty      Int     @default(1)
  position String? /// e.g. "control board", "fan 1"

  @@unique([modelId, partId, position])
}

/// Fault codes live at series level; a model-level row overrides the series row for that model only.
enum FaultKind {
  FAULT /// the drive trips
  WARNING /// the manual's warning — whether it stops is NOT implied (mustStop)
  EVENT /// pure event / event warning
  INFO
}

enum MustStop {
  YES
  NO
  UNVERIFIED /// never shown as "does not stop"
}

enum FaultCodeStatus {
  DRAFT
  REVIEW /// 待审核
  APPROVED
  RETIRED
}

/// One fault/alarm code of a series (朱总 2026-11-10: per-series library, public read-only query).
/// publicText = OUR words per language (what may go out); manualText = the manufacturer's text and its translations —
/// internal reference only, never published (copyright). Internal fields never leave DCiT OS.
model FaultCode {
  id            String              @id @default(cuid())
  seriesId      String
  series        Series              @relation(fields: [seriesId], references: [id])
  modelId       String?
  model         Model?              @relation(fields: [modelId], references: [id])
  code          String /// verbatim, leading zeros kept: F30001, 0001, A2B3
  title         String /// display title (Chinese when known)
  meaning       String? /// legacy free text (case archive)
  firstChecks   String? /// legacy free text (case archive)
  reviewed      Boolean             @default(false) /// = status APPROVED; kept for older pages
  kind          FaultKind           @default(FAULT)
  mustStop      MustStop            @default(UNVERIFIED)
  appliesTo     String? /// scope words: "Primary control program Rev V"
  publicText    Json? /// {zh|en|th: {title, meaning, causes[], checks[], remedy, safety, prepare}}
  manualText    Json? /// {en|zh|th: {meaning, actions}} — manufacturer text, internal
  source        Json? /// {title, docId, revision, date, page, url, sha256}
  related       String[]            @default([])
  keywords      String[]            @default([]) /// words people search by besides the title: 过流, OC, กระแสเกิน
  internalNotes String?
  commonParts   String?
  status        FaultCodeStatus     @default(DRAFT)
  isPublic      Boolean             @default(false)
  reviewNote    String?
  reviewedById  String?
  reviewedBy    Employee?           @relation("FaultCodeReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  version       Int                 @default(1)
  origin        String              @default("MANUAL") /// MANUAL | IMPORT | CASE
  importId      String?
  import        FaultCodeImport?    @relation(fields: [importId], references: [id])
  searchText    String              @default("") /// lower-cased internal search text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  published     PublishedFaultCode?

  @@index([seriesId, code])
  @@index([status])
}

/// One import run: file name, who, when, what happened.
model FaultCodeImport {
  id        String      @id @default(cuid())
  fileName  String
  format    String /// GROK_JSON | CSV
  actorId   String
  actor     Employee    @relation(fields: [actorId], references: [id])
  createdAt DateTime    @default(now())
  counts    Json /// {created, updated, skipped, flagged}
  codes     FaultCode[]
}

/// The only table the public API reads: a copy of approved + public codes, public fields only, made by "publish".
model PublishedFaultCode {
  id          String    @id @default(cuid())
  faultCodeId String    @unique
  faultCode   FaultCode @relation(fields: [faultCodeId], references: [id], onDelete: Cascade)
  brandSlug   String
  brandName   String
  seriesSlug  String
  seriesName  String
  category    String?
  code        String
  codeKey     String /// lower-cased code for lookups
  kind        FaultKind
  mustStop    MustStop
  appliesTo   String?
  content     Json /// {zh|en|th: {title, meaning, causes[], checks[], remedy, safety, prepare}}
  source      Json?
  related     String[]  @default([])
  searchText  String /// public fields only
  publishedAt DateTime
  version     Int

  @@unique([brandSlug, seriesSlug, codeKey])
  @@index([codeKey])
}

model PublishRun {
  id        String   @id @default(cuid())
  actorId   String
  actor     Employee @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())
  added     Int
  updated   Int
  removed   Int
}

model MaintenanceStandard {
  id             String  @id @default(cuid())
  seriesId       String
  series         Series  @relation(fields: [seriesId], references: [id])
  modelId        String?
  model          Model?  @relation(fields: [modelId], references: [id])
  item           String /// "clean heatsink", "replace fan", "DC-link capacitor check"
  intervalHours  Int?
  intervalMonths Int?
  criterion      String?
  reviewed       Boolean @default(false)
}

// ───────────────────────── ALM — the single asset ─────────────────────────

enum AssetType {
  VFD
  MOTOR
  PLC
  PANEL
  DRIVE_TRAIN
  SENSOR
  OTHER
}

enum AssetStatus {
  ONBOARDED /// 建档 / 接管
  IN_SERVICE /// 在役运行
  MAINTENANCE /// 维护保养
  REPAIR /// 故障维修
  OVERHAUL /// 系统性检修 / 改造
  ACCEPTANCE /// 测试与验收
  SPARE /// 备用库 / 共享备机
  RETIRED /// 退役 / 替换
}

enum AssetOrigin {
  NEW_INSTALL
  TAKEOVER
}

/// One physical machine = one ATH number = one serial number, for life.
/// Transfers between customers change customerId / plantId / location and write an event; the ATH never changes.
model Asset {
  id                  String      @id @default(cuid())
  code                String      @unique /// ATH26100001
  entityId            String
  entity              LegalEntity @relation(fields: [entityId], references: [id])
  type                AssetType
  modelId             String?
  model               Model?      @relation(fields: [modelId], references: [id])
  serialNumber        String /// vendor's S/N verbatim — the true identity
  customerAssetNo     String? /// the customer's own tag, if any
  customerId          String?
  customer            Customer?   @relation(fields: [customerId], references: [id])
  plantId             String?
  plant               Plant?      @relation(fields: [plantId], references: [id])
  location            String? /// workshop / line / position text
  status              AssetStatus @default(ONBOARDED)
  origin              AssetOrigin @default(TAKEOVER)
  installedAt         DateTime?
  responsibleId       String?
  responsible         Employee?   @relation("AssetResponsible", fields: [responsibleId], references: [id])
  configuration       Json? /// options, brake unit, filter, encoder …
  operatingConditions Json? /// load type, running hours/day, dust, temperature, grid, cooling
  nameplatePhoto      String?
  photos              Json?
  qrPrintedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  events           AssetEvent[]
  relationsFrom    AssetRelation[]     @relation("RelFrom")
  relationsTo      AssetRelation[]     @relation("RelTo")
  parameterBackups ParameterBackup[]
  readings         AssetReading[]
  orderLinks       ServiceOrderAsset[]
  inspections      Inspection[]
  repairJobs       RepairJob[]
  stockMovements   StockMovement[]

  @@unique([serialNumber, modelId])
  @@index([customerId, status])
}

enum AssetRelationType {
  DRIVES /// VFD → motor
  INSTALLED_IN /// VFD → panel
  CONTROLLED_BY /// VFD → PLC
  COUPLED_TO /// motor → gearbox / drive train
}

model AssetRelation {
  id          String            @id @default(cuid())
  fromAssetId String
  fromAsset   Asset             @relation("RelFrom", fields: [fromAssetId], references: [id])
  toAssetId   String
  toAsset     Asset             @relation("RelTo", fields: [toAssetId], references: [id])
  relation    AssetRelationType
  validFrom   DateTime          @default(now())
  validTo     DateTime?

  @@index([fromAssetId])
  @@index([toAssetId])
}

enum AssetEventType {
  ONBOARDED
  CONDITION_RECORDED
  PARAMETER_BACKUP
  TRANSFERRED /// customer / plant / location changed
  RELATION_CHANGED
  SERVICE_REQUESTED /// QTTH created
  INSPECTED /// INTH
  QUOTED
  ORDER_CONFIRMED
  QUOTE_DECLINED /// customer declined the quote (QuoteDecline); undone → STATUS_CHANGED back
  MAINTAINED /// PMTH
  REPAIRED /// RPTH
  OVERHAULED
  PART_REPLACED /// from OBTH
  RECEIVED_WORKSHOP /// ERTH
  DELIVERED /// DNTH signed by the customer
  TESTED
  ACCEPTED
  INVOICED
  PAID
  READING
  ALARM
  CASE_ARCHIVED
  STATUS_CHANGED
  RETIRED
}

/// The "前世今生": an append-only stream. Everything else is a view over it.
model AssetEvent {
  id             String         @id @default(cuid())
  assetId        String
  asset          Asset          @relation(fields: [assetId], references: [id])
  type           AssetEventType
  occurredAt     DateTime       @default(now())
  actorId        String?
  actor          Employee?      @relation(fields: [actorId], references: [id])
  actorName      String? /// for customer-side actors (not numbered)
  serviceOrderId String?
  serviceOrder   ServiceOrder?  @relation(fields: [serviceOrderId], references: [id])
  sourceDocNo    String? /// INTH…, RPTH…, OBTH…, TITH…
  summary        String /// one line, human-readable
  payload        Json? /// measurements, values, before/after
  attachments    Json? /// [{name, url}]
  createdAt      DateTime       @default(now())

  @@index([assetId, occurredAt])
  @@index([serviceOrderId])
}

model ParameterBackup {
  id      String   @id @default(cuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id])
  takenAt DateTime @default(now())
  fileUrl String
  note    String?
  byName  String?
}

/// Runtime layer (Phase 3). Table exists so Phase 1 code can write manual inspection readings into it.
model AssetReading {
  id      String   @id @default(cuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id])
  at      DateTime @default(now())
  metric  String /// output_hz, output_a, dc_bus_v, heatsink_c, run_hours …
  value   Decimal  @db.Decimal(18, 4)
  source  String   @default("MANUAL") /// MANUAL | GATEWAY

  @@index([assetId, metric, at])
}

// ───────────────────────── SLM — one service = one QTTH ─────────────────────────

enum ServiceOrderStatus {
  RECEIVED /// 已受理 — QTTH draft created at report time
  ASSIGNED /// 已派工
  DIAGNOSING /// 诊断中
  QUOTE_PENDING /// 待确认报价
  DECLINED /// 客户拒绝报价 — the machine goes back on a DNTH, the inspection fee is invoiced or waived (QuoteDecline)
  IN_PROGRESS /// 执行中
  ACCEPTANCE_PENDING /// 待验收
  ACCEPTED /// 已验收
  INVOICED /// 已开票
  CLOSED /// 已完成
  CANCELLED
}

/// Quote margin against the 50 % floor: NOT_NEEDED (at or above), PENDING (below, waiting for the MD), APPROVED, REJECTED.
enum MarginApproval {
  NOT_NEEDED
  PENDING
  APPROVED
  REJECTED
}

enum ServiceKind {
  REPAIR
  MAINTENANCE
  OVERHAUL
  CONTRACT /// in-contract work: QTTH still created, amount 0 or contract price
  PARTS_SALE
}

/// Who does the work (decided 2026-11-08): IN_HOUSE, or PARTNER = 合作维修 — a partner repairs it under our POTH,
/// the margin floor is 33 % instead of 50 %, and the partner never meets the customer (we carry the machine both ways).
/// 业务模式 (朱总 2026-11-09): chosen when the order is created and never changed. It decides the documents, the margin
/// floor (ModeRule) and the inquiry/quote route. A repair that turns out to need a partner is closed and reopened as
/// PARTNER_REPAIR (reopenAsPartner) — the two are never mixed on one order. Trade orders carry SKUs, not assets.
enum BusinessMode {
  REPAIR /// 维修 — we inspect, quote and repair ourselves
  PARTNER_REPAIR /// 合作维修 — we inspect, a partner repairs, we retest and deliver
  MAINTENANCE /// 维保 — kind MAINTENANCE (维护保养) / OVERHAUL (系统性检修) / CONTRACT (合同维保)
  AUTOMATION_PROJECT /// 自动化项目
  DOMESTIC_TRADE /// 国内贸易
  INTERNATIONAL_TRADE /// 国际贸易
}

/// Minimum gross margin per business mode; a quote below it needs the MD (rule decided 2026-11-09, MD edits on /admin).
model ModeRule {
  mode         BusinessMode @id
  minMarginPct Decimal      @db.Decimal(5, 4)
  updatedBy    String? /// employee code of the last editor
  updatedAt    DateTime     @updatedAt
}

model ServiceOrder {
  id                 String             @id @default(cuid())
  no                 String             @unique /// QTTH26110201
  entityId           String
  entity             LegalEntity        @relation(fields: [entityId], references: [id])
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id])
  plantId            String?
  plant              Plant?             @relation(fields: [plantId], references: [id])
  mode               BusinessMode       @default(REPAIR) /// fixed at creation
  kind               ServiceKind        @default(REPAIR) /// sub-type inside the mode (维保: MAINTENANCE / OVERHAUL / CONTRACT)
  partnerReason      String? /// PARTNER_REPAIR: why a partner repairs it (not our trade: motor rewinding, CNC …)
  transferredFromId  String?            @unique /// the REPAIR order this partner repair was reopened from
  transferredFrom    ServiceOrder?      @relation("OrderTransfer", fields: [transferredFromId], references: [id])
  transferredTo      ServiceOrder?      @relation("OrderTransfer")
  warrantyDays       Int? /// what we promise the customer; for PARTNER work the POTH carries the same days (back-to-back)
  status             ServiceOrderStatus @default(RECEIVED)
  reportedSymptom    String?
  reportedAlarm      String?
  productionImpact   String?
  reportedById       String?
  reportedBy         Contact?           @relation(fields: [reportedById], references: [id])
  reportedAt         DateTime           @default(now())
  assigneeId         String?
  assignee           Employee?          @relation("OrderAssignee", fields: [assigneeId], references: [id])
  createdById        String
  createdBy          Employee           @relation("OrderCreator", fields: [createdById], references: [id])
  salesId            String? /// 销售负责人 (朱总 2026-11-11): whose target this order counts toward; empty = the person who opened it
  sales              Employee?          @relation("OrderSales", fields: [salesId], references: [id])
  customerRef        String? /// customer's own order number, verbatim (e.g. XCGDD2610140001)
  poLines            Json? /// the customer PO, line by line: [{lineNo, description, qty, unit, isService}] — delivery notes are checked against it
  requestLines       Json? /// 贸易 (no ATH): the customer's inquiry, [{sku?, description, qty, unit, neededBy?, hsCode?, origin?}] — the quote starts from it, shortages raise a PRTH
  project            Json? /// 自动化项目 (2026-11-09): {name, dueDate?, scope?, solution?, deliverables?: [{name, qty}], labour?: [{description, hours, costPerHour?}]} — BOM in requestLines, milestones in ProjectMilestone
  tradeTerms         Json? /// 国际贸易 (2026-11-09): {currency, incoterm, place, destCountry, destPort?, shipMode, paymentTerms, paymentDays} — src/lib/export.ts
  attachments        Json? /// [{name, url, kind: PO | REPORT_MSG | PHOTO}] — originals kept for later comparison
  currency           String             @default("THB")
  fxRateToCny        Decimal?           @db.Decimal(18, 8)
  subtotal           Decimal?           @db.Decimal(18, 2)
  vatAmount          Decimal?           @db.Decimal(18, 2)
  total              Decimal?           @db.Decimal(18, 2)
  totalCny           Decimal?           @db.Decimal(18, 2)
  quoteSentAt        DateTime?
  quoteConfirmedAt   DateTime?
  closedAt           DateTime?
  // ── margin gate (流程图: 毛利率不低于 50%，否则 MD 审批) ──
  costTotal          Decimal?           @db.Decimal(18, 2) /// sum of line qty × unitCost, order currency
  marginPct          Decimal?           @db.Decimal(6, 4) /// (subtotal − costTotal) / subtotal
  marginApproval     MarginApproval     @default(NOT_NEEDED)
  marginApprovedById String?
  marginApprovedBy   Employee?          @relation("MarginApprover", fields: [marginApprovedById], references: [id])
  marginApprovedAt   DateTime?
  marginNote         String?
  // ── acceptance lock (流程图: 验收后锁定成本与价格，不再新增 PR/PO) ──
  lockedAt           DateTime?
  lockedById         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assets         ServiceOrderAsset[]
  lines          QuoteLine[]
  inspections    Inspection[]
  repairJobs     RepairJob[]
  acceptance     Acceptance?
  decline        QuoteDecline?
  events         AssetEvent[]
  documents      Document[]
  stockMovements StockMovement[]
  taxInvoices    TaxInvoice[]
  invoices       Invoice[]
  deliveries     DeliveryNote[]
  inquiries      PurchaseInquiry[]
  purchaseOrders PurchaseOrder[]
  milestones     ProjectMilestone[]

  @@index([customerId, status])
  @@index([mode, status])
}

/// 自动化项目 milestone (flow 自动化项目-流程图-v1, 2026-11-09): nine per project, completed in order (src/lib/project.ts).
/// A milestone with payPct is invoiced (TITH + IVTH) for that share of the contract once done; FAT/SAT keep their test record.
model ProjectMilestone {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  seq            Int
  phase          String /// CONTRACT DESIGN PROCUREMENT BUILD FAT DELIVERY COMMISSIONING SAT HANDOVER
  payPct         Decimal?     @db.Decimal(5, 4) /// share of the contract invoiced at this milestone
  plannedOn      DateTime?
  doneAt         DateTime?
  doneById       String? /// employee id
  note           String?
  attachments    Json? /// test record, signed protocol, photos: [{name, url, kind}]
  taxInvoiceNo   String? /// the TITH issued for this instalment
  invoiceNo      String? /// the IVTH issued with it

  @@unique([serviceOrderId, seq])
}

model ServiceOrderAsset {
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  assetId        String
  asset          Asset        @relation(fields: [assetId], references: [id])
  isPrimary      Boolean      @default(true)

  @@id([serviceOrderId, assetId])
}

model QuoteLine {
  id               String       @id @default(cuid())
  serviceOrderId   String
  serviceOrder     ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  lineNo           Int
  assetCode        String? /// every line carries the asset it is for
  partId           String?
  part             Part?        @relation(fields: [partId], references: [id])
  description      String
  descriptionLocal String? /// Thai text required on tax invoices
  qty              Decimal      @db.Decimal(12, 3)
  unit             String       @default("pcs")
  unitPrice        Decimal      @db.Decimal(18, 2)
  amount           Decimal      @db.Decimal(18, 2)
  costRef          Decimal?     @db.Decimal(18, 2) /// last purchase cost shown to sales, not to customer
  unitCost         Decimal?     @db.Decimal(18, 2) /// cost used for the margin: entered, or the part's last cost / purchase comparison

  @@unique([serviceOrderId, lineNo])
}

/// INTH — one inspection of one asset. Feeds template 08 Diagnostic Report.
model Inspection {
  id             String          @id @default(cuid())
  no             String          @unique /// INTH26110201
  serviceOrderId String
  serviceOrder   ServiceOrder    @relation(fields: [serviceOrderId], references: [id])
  assetId        String
  asset          Asset           @relation(fields: [assetId], references: [id])
  engineerId     String
  engineer       Employee        @relation(fields: [engineerId], references: [id])
  inspectedAt    DateTime        @default(now())
  symptoms       String?
  conditions     String?
  findings       String?
  probableCause  String?
  recommendation String?
  tests          Json? /// [{test, criterion, result, recordId}]
  instruments    String?
  openIssues     String?
  conclusion     String?
  attachments    Json?
  location       RepairLocation? /// where it was inspected: SITE or WORKSHOP
  attachmentRefs String? /// photo / record IDs referred to in the evidence table (P1–P3, M1 …)
  needs          Json? /// internal only, never printed (rule 21): [{kind PART|LABOUR, partSku?, vendorPartNo?, description, descriptionLocal?, qty, unit, onHand?, short?}] — saved for real → stock checked, short parts raise a PRTH (flow step 3)
  draft          Boolean         @default(false) /// "save draft": number reserved, but no document, event or status change until saved for real
}

enum RepairKind {
  MAINTENANCE
  REPAIR
  OVERHAUL
  FIELD_SERVICE
}

enum RepairLocation {
  SITE
  WORKSHOP
}

/// RPTH (and PMTH when kind = MAINTENANCE). Feeds templates 09 / 10 / 11.
model RepairJob {
  id              String         @id @default(cuid())
  no              String         @unique /// RPTH26110201 or PMTH26110201
  serviceOrderId  String
  serviceOrder    ServiceOrder   @relation(fields: [serviceOrderId], references: [id])
  assetId         String
  asset           Asset          @relation(fields: [assetId], references: [id])
  engineerId      String
  engineer        Employee       @relation(fields: [engineerId], references: [id])
  kind            RepairKind
  location        RepairLocation @default(SITE)
  startedAt       DateTime?
  finishedAt      DateTime?
  confirmedFault  String?
  rootCause       String?
  workPerformed   String?
  partsReplaced   Json? /// [{partSku, qty, oldSerial, newSerial, obthNo}]
  configBackupRef String?
  laborHours      Decimal?       @db.Decimal(8, 2)
  tests           Json? /// [{test, criterion, result, pass}]
  openIssues      String?
  conclusion      String?
  attachments     Json?
  // ── PMTH only (kind = MAINTENANCE) ──
  level           String? /// QUARTERLY | HALF_YEAR | ANNUAL | CONTRACT
  runHours        Int? /// cumulative running hours at this visit
  checklist       Json? /// [{item, criterion, measured, verdict: OK | HANDLED | HAZARD | WATCH, photo}]
  hazards         String? /// what was found and not yet fixed — the real deliverable of maintenance
  handled         String? /// what was fixed on this visit
  recommendation  String?
  conditionRating String? /// GOOD | GOOD_WITH_ISSUE | POOR
  nextDueAt       DateTime?
  nextDueHours    Int?
  consumables     String? /// PMTH: consumables / parts used (stock-out brings them in)
  escortContactId String? /// PMTH: the customer's person on site (a Contact; masked wherever shown)
  // ── RPTH ──
  travelCost      Decimal?       @db.Decimal(14, 2) /// travel / other costs, in the order's currency
}

enum AcceptanceStatus {
  ACCEPTED
  CONDITIONAL
  REJECTED
}

/// Template 12 (service completion) is the engineer's record; template 13 (customer acceptance) is this row signed.
/// 客户拒绝报价 (朱总 2026-11-09, mockup docs/mockups/quote-decline-v0.1.html): why, the customer's reply (required, in
/// ServiceOrder.attachments kind DECLINE), the inspection fee per machine — charged by default, waived only with a reason.
/// The order goes DECLINED and is locked; it closes once the machine is back with the customer (signed DNTH, when an
/// ERTH took it in) and the fee is invoiced (TITH) or waived. Undo (back to QUOTE_PENDING) only before a DNTH or TITH.
model QuoteDecline {
  id             String       @id @default(cuid())
  serviceOrderId String       @unique
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  reason         String /// PRICE | REPLACE | LEAD_TIME | SELF | OTHER
  note           String?
  toldAt         DateTime /// when the customer said no
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  fees           Json /// [{assetCode, amount}] in the order currency, before VAT; [] when waived
  waivedReason   String? /// internal, never on a customer document or the portal
  actorId        String
  actor          Employee     @relation(fields: [actorId], references: [id])
  createdAt      DateTime     @default(now())
}

model Acceptance {
  id                String           @id @default(cuid())
  serviceOrderId    String           @unique
  serviceOrder      ServiceOrder     @relation(fields: [serviceOrderId], references: [id])
  deliverables      Json /// [{deliverable, criterion, result}]
  punchList         String?
  status            AcceptanceStatus
  acceptedAt        DateTime?
  warrantyStart     DateTime?
  warrantyTerms     String?
  customerContactId String?
  customerContact   Contact?         @relation(fields: [customerContactId], references: [id])
  customerSignatory String?
  signatureUrl      String?
  dcitSignatory     String?
}

// ───────────────────────── SCM (Phase 1 slice) ─────────────────────────

model Part {
  id               String   @id @default(cuid())
  sku              String   @unique /// SIE-6SL3120... = <brand>-<vendor part no>
  brandId          String?
  brand            Brand?   @relation(fields: [brandId], references: [id])
  vendorPartNo     String
  name             String
  nameLocal        String?
  unit             String   @default("pcs")
  lastCost         Decimal? @db.Decimal(18, 2)
  lastCostCurrency String?
  substitutes      Json? /// [sku, …]
  safetyStock      Int?

  bomLines   ModelPart[]
  quoteLines QuoteLine[]
  movements  StockMovement[]
}

enum MovementDirection {
  IN /// IBTH
  OUT /// OBTH
}

model StockMovement {
  id                 String            @id @default(cuid())
  no                 String /// IBTH261102001 / OBTH261102001 — one number per document; the document may hold several SKUs
  lineNo             Int               @default(1) /// each line moves exactly one SKU (or, for custody moves, one machine)
  direction          MovementDirection
  kind               StockKind         @default(PART)
  partId             String? /// PART lines; custody lines move a customer machine (assetId) instead
  part               Part?             @relation(fields: [partId], references: [id])
  qty                Decimal           @db.Decimal(12, 3)
  warehouse          String            @default("RAYONG")
  batch              String?
  assetId            String? /// OUT: which machine it went into
  asset              Asset?            @relation(fields: [assetId], references: [id])
  serviceOrderId     String?
  serviceOrder       ServiceOrder?     @relation(fields: [serviceOrderId], references: [id])
  oldPartDisposition String? /// where the removed part went
  movedAt            DateTime          @default(now())
  byName             String?
  unitCost           Decimal?          @db.Decimal(18, 2) /// IN: cost of this line (also updates Part.lastCost)
  supplierRef        String? /// IN: supplier's delivery / invoice number, verbatim
  purchaseOrderId    String? /// IN: the POTH this receipt fulfils
  purchaseOrder      PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  accessories        Json? /// custody: [{item, qty}] that travel with the machine — checked back on the return
  attachments        Json? /// custody: nameplate / appearance photos
  counterpartySigned String? /// custody: who signed at the partner, verbatim
  refNo              String? /// SUBCONTRACT_RETURN: the 外送 OBTH it closes

  @@unique([no, lineNo])
}

/// PART = parts stock. SUBCONTRACT_OUT (OBTH, printed as 外送维修单) and SUBCONTRACT_RETURN (IBTH) move a customer
/// machine to and from a partner — no new prefix (decided 2026-11-08), and they never change parts stock.
enum StockKind {
  PART
  SUBCONTRACT_OUT
  SUBCONTRACT_RETURN
}

// ───────────────────────── SCM purchasing (流程图: PRTH 询价比价 → POTH 采购 → IBTH 到货) ─────────────────────────

/// Suppliers — master data numbered like customers: STH + YYMM + 3-digit serial (decided 2026-11-08).
model Supplier {
  id           String              @id @default(cuid())
  code         String?             @unique /// STH2611001 — optional only so databases with suppliers from before 2026-11-08 can upgrade; db:seed numbers them, new ones always get one
  entityId     String?
  name         String
  nameLocal    String?
  taxId        String?             @unique
  branchCode   String?             @default("00000")
  contactName  String?
  phone        String?
  email        String?
  address      String?
  currency     String              @default("THB")
  paymentTerms String?
  leadTimeDays Int?
  active       Boolean             @default(true)
  isPartner    Boolean             @default(false) /// 合作维修 partner (repairs machines for us), not only a parts vendor
  capabilities String[]            @default([]) /// asset types / trades it repairs: MOTOR, CNC, SERVO, VFD, PLC, PANEL … — drives the recommendation
  countryCode  String              @default("TH")
  paymentMode  SupplierPaymentMode @default(PER_ORDER) /// TH partners: MONTHLY (月结 15 天); others per order (decided 2026-11-08)
  paymentDays  Int? /// MONTHLY: days after month end (15)
  createdAt    DateTime            @default(now())

  quotes   SupplierQuote[]
  orders   PurchaseOrder[]
  ratings  SupplierRating[]
  invoices SupplierInvoice[]
}

enum SupplierPaymentMode {
  MONTHLY /// 月结: due = end of the invoice month + paymentDays
  PER_ORDER /// 按单结: due on the invoice date
}

/// PARTS = buy parts into stock; SUBCONTRACT = 合作维修 — a partner repairs a customer machine (service lines, no SKU).
enum PurchaseKind {
  PARTS
  SUBCONTRACT
}

enum InquiryStatus {
  OPEN /// sent to suppliers, waiting for quotes
  COMPARED /// a quote was selected — costs flow back into the QTTH
  ORDERED /// a POTH was raised from it
  CANCELLED
}

/// PRTH — one purchase inquiry (one or more lines) sent to one or more suppliers; their quotes are compared here.
model PurchaseInquiry {
  id             String        @id @default(cuid())
  no             String        @unique /// PRTH26110701
  entityId       String
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  status         InquiryStatus @default(OPEN)
  kind           PurchaseKind  @default(PARTS)
  requestedById  String
  requestedBy    Employee      @relation("InquiryRequester", fields: [requestedById], references: [id])
  neededBy       DateTime?
  note           String?
  lines          Json /// [{lineNo, partSku?, vendorPartNo?, description, qty, unit, assetCode?}]
  attachments    Json?
  createdAt      DateTime      @default(now())

  quotes SupplierQuote[]
  orders PurchaseOrder[]

  @@index([serviceOrderId])
}

/// One supplier's answer to a PRTH (usually read from their quotation PDF). `selected` wins the comparison.
model SupplierQuote {
  id           String          @id @default(cuid())
  inquiryId    String
  inquiry      PurchaseInquiry @relation(fields: [inquiryId], references: [id])
  supplierId   String
  supplier     Supplier        @relation(fields: [supplierId], references: [id])
  quoteNo      String? /// supplier's number, verbatim
  quoteDate    DateTime?
  validUntil   DateTime?
  currency     String          @default("THB")
  vatRate      Decimal?        @db.Decimal(5, 4)
  subtotal     Decimal         @db.Decimal(18, 2)
  total        Decimal?        @db.Decimal(18, 2)
  leadTimeDays Int?
  paymentTerms String?
  lines        Json /// [{lineNo, vendorPartNo?, description, qty, unit, unitPrice, amount}] — lineNo matches the inquiry line
  warrantyDays Int? /// SUBCONTRACT: partner warranty on the repair
  solution     String? /// SUBCONTRACT: the partner's repair plan, verbatim
  attachments  Json?
  selected     Boolean         @default(false)
  createdAt    DateTime        @default(now())

  @@index([inquiryId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL /// some lines received (IBTH)
  RECEIVED
  CANCELLED
}

/// POTH — what we order from a supplier; receipts (IBTH) post against its lines until it is RECEIVED.
model PurchaseOrder {
  id             String              @id @default(cuid())
  no             String              @unique /// POTH26110701
  entityId       String
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  inquiryId      String?
  inquiry        PurchaseInquiry?    @relation(fields: [inquiryId], references: [id])
  serviceOrderId String?
  serviceOrder   ServiceOrder?       @relation(fields: [serviceOrderId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  kind           PurchaseKind        @default(PARTS)
  warrantyDays   Int? /// SUBCONTRACT: = the customer's warranty (back-to-back)
  scope          String? /// SUBCONTRACT: repair scope / acceptance criteria the partner signed up to
  version        Int                 @default(1) /// a change (extra cost, new date) bumps the version — same number
  revisions      Json? /// [{version, at, by, reason, subtotalFrom, subtotalTo, expectedFrom, expectedTo, customerConsent}]
  orderedAt      DateTime            @default(now())
  expectedAt     DateTime?
  currency       String              @default("THB")
  fxRateToCny    Decimal?            @db.Decimal(18, 8)
  subtotal       Decimal             @db.Decimal(18, 2)
  vatRate        Decimal             @db.Decimal(5, 4)
  vatAmount      Decimal             @db.Decimal(18, 2)
  total          Decimal             @db.Decimal(18, 2)
  totalCny       Decimal?            @db.Decimal(18, 2)
  supplierRef    String? /// supplier's order confirmation / invoice number, verbatim
  paymentTerms   String?
  lines          Json /// [{lineNo, partSku?, vendorPartNo?, description, qty, unit, unitPrice, amount, receivedQty}]
  attachments    Json?
  createdById    String
  createdBy      Employee            @relation("PoCreator", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())

  receipts   StockMovement[]
  milestones SubcontractMilestone[]
  invoices   SupplierInvoice[]
  ratings    SupplierRating[]

  @@index([serviceOrderId])
}

enum PartnerStage {
  SENT /// written by the 外送 OBTH
  ARRIVED /// partner confirms receipt
  DISASSEMBLED /// teardown / findings confirmed
  REPAIRING
  TESTING
  COMPLETED /// partner done: test report, warranty card, replaced parts
  RETURNED /// written by the 外协返回 IBTH
  RETEST_PASSED /// our own retest
  RETEST_FAILED /// back to the partner under the POTH warranty
}

/// SRM progress on a SUBCONTRACT POTH — internal only, never shown to the customer (decided 2026-11-08).
model SubcontractMilestone {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  assetId         String?
  stage           PartnerStage
  at              DateTime      @default(now())
  note            String?
  attachments     Json? /// photos, test report, warranty card
  sourceDocNo     String? /// OBTH / IBTH that wrote it
  byId            String
  by              Employee      @relation("MilestoneBy", fields: [byId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId, at])
}

/// 合作伙伴评价 after each SUBCONTRACT POTH: 1–5 each; the average ranks partners in the recommendation.
model SupplierRating {
  id              String         @id @default(cuid())
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  quality         Int
  onTime          Int
  price           Int
  cooperation     Int
  note            String?
  byId            String
  by              Employee       @relation("RatingBy", fields: [byId], references: [id])
  createdAt       DateTime       @default(now())

  @@unique([purchaseOrderId])
}

enum PayableStatus {
  OPEN
  PAID
  CANCELLED
}

/// 应付 — a supplier's invoice against a POTH. Due date from the supplier's payment mode; paying issues a PVTH.
model SupplierInvoice {
  id              String        @id @default(cuid())
  entityId        String
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  invoiceNo       String /// supplier's number, verbatim
  invoiceDate     DateTime
  currency        String        @default("THB")
  subtotal        Decimal       @db.Decimal(18, 2)
  vatAmount       Decimal       @db.Decimal(18, 2)
  total           Decimal       @db.Decimal(18, 2)
  whtRate         Decimal       @db.Decimal(5, 4) /// 3 % hire-of-work for TH juristic partners, 0 otherwise
  whtAmount       Decimal       @db.Decimal(18, 2) /// on the subtotal
  payable         Decimal       @db.Decimal(18, 2) /// total − WHT
  dueDate         DateTime
  status          PayableStatus @default(OPEN)
  paidAt          DateTime?
  paymentNo       String? /// PVTH… issued when paid
  paymentRef      String? /// bank transfer reference, verbatim
  attachments     Json?
  createdById     String
  createdAt       DateTime      @default(now())

  @@unique([supplierId, invoiceNo])
  @@index([status, dueDate])
}

// ───────────────────────── T&O / FIN (Phase 1 slice) ─────────────────────────

/// TITH — Thai tax invoice: local currency, Thai description, VAT as a separate line.
model TaxInvoice {
  id                String       @id @default(cuid())
  no                String       @unique /// TITH26110201
  serviceOrderId    String
  serviceOrder      ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  issuedAt          DateTime
  seq               Int? /// running count of tax invoices of this entity (voided ones keep their place) → เล่มที่ / เลขที่ในเล่ม
  bookNo            String? /// เล่มที่, 3 digits, consecutive per entity: book = ceil(seq / taxInvoiceBookSize)
  bookSeq           Int? /// position inside the book, 1 … taxInvoiceBookSize
  currency          String /// THB in Thailand, by law
  lines             Json /// [{descriptionLocal, descriptionEn, qty, unitPrice, amount}]
  subtotal          Decimal      @db.Decimal(18, 2)
  vatRate           Decimal      @db.Decimal(5, 4)
  vatAmount         Decimal      @db.Decimal(18, 2)
  total             Decimal      @db.Decimal(18, 2)
  fxRateToCny       Decimal      @db.Decimal(18, 8)
  totalCny          Decimal      @db.Decimal(18, 2)
  buyerTaxId        String?
  buyerBranch       String?
  voidedAt          DateTime? /// voided numbers are kept, never reused
  voidReason        String?
  // Void needs the MD (decision 2026-11-08): anyone may request, only the MD approves or rejects.
  voidStatus        VoidStatus   @default(NONE)
  voidRequestedAt   DateTime?
  voidRequestedById String?
  voidRequestReason String?
  voidDecidedById   String?
  voidDecidedAt     DateTime?
  voidDecisionNote  String?

  invoices Invoice[]
}

enum VoidStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

/// IVTH — the Invoice the customer pays against; also serves as the payment record (no separate receipt).
/// cancelledAt: set when its tax invoice was voided before any payment — the number stays, the receivable is gone.
model Invoice {
  id             String            @id @default(cuid())
  no             String            @unique /// IVTH26110201
  serviceOrderId String
  serviceOrder   ServiceOrder      @relation(fields: [serviceOrderId], references: [id])
  taxInvoiceId   String?
  taxInvoice     TaxInvoice?       @relation(fields: [taxInvoiceId], references: [id])
  issuedAt       DateTime
  dueAt          DateTime?
  currency       String
  amountDue      Decimal           @db.Decimal(18, 2)
  cancelledAt    DateTime?
  cancelReason   String?
  paidAmount     Decimal?          @db.Decimal(18, 2)
  whtAmount      Decimal?          @db.Decimal(18, 2) /// tax withheld by the customer
  whtCertRef     String? /// customer's withholding certificate reference
  paidAt         DateTime?
  bankRef        String?
  statementId    String?
  statement      MonthlyStatement? @relation(fields: [statementId], references: [id])
  attachments    Json? /// customer's payment proofs: [{name, url, kind: PAYMENT_PROOF | WHT_CERT}]

  receipts Receipt[]
}

/// RCTH — ใบเสร็จรับเงิน, one per payment received against an IVTH (decided 2026-11-07). Records this
/// payment's cash, withholding and settled amount, the bank reference and the original tax invoice; never recomputes VAT.
model Receipt {
  id            String   @id @default(cuid())
  no            String   @unique /// RCTH26110701
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  taxInvoiceNo  String? /// original TITH, printed on the receipt
  receivedAt    DateTime /// actual date the money arrived
  currency      String
  cashAmount    Decimal  @db.Decimal(18, 2)
  whtAmount     Decimal  @db.Decimal(18, 2)
  settledAmount Decimal  @db.Decimal(18, 2) /// cash + WHT
  bankRef       String?
  whtCertRef    String?
  attachments   Json?
  createdAt     DateTime @default(now())
}

/// BLTH — monthly statement for credit customers: the list of IVTH due this month.
model MonthlyStatement {
  id         String    @id @default(cuid())
  no         String    @unique /// BLTH26113001
  customerId String
  period     String /// 2611
  issuedAt   DateTime
  currency   String
  total      Decimal   @db.Decimal(18, 2)
  invoices   Invoice[]
}

// ───────────────────────── Documents registry ─────────────────────────

enum DocType {
  QT // quotation / service order
  PR // purchase inquiry
  PO // purchase order
  IN // inspection
  RP // repair
  PM // preventive maintenance record
  ER // equipment receiving
  TI // tax invoice
  IV // invoice
  BL // monthly statement
  PF // proforma invoice
  IB // stock in
  OB // stock out
  DN // delivery note (DNTH) — decided 2026-11-03
  CN // credit note
  DB // debit note
  TF // spare transfer
  RT // return
  SC // service contract
  PV // payment voucher
  TR // training
  RC // receipt (RCTH) — decided 2026-11-07
}

/// Every issued number is registered here once, whatever table holds the detail. Voided rows stay.
enum DeliveryStatus {
  DRAFT
  ISSUED /// checked against the PO and printed
  SIGNED /// customer signed for it
}

/// DNTH — what physically goes back to the customer. Every PO line must match; what came in on the ERTH and
/// old parts marked "return to customer" on the RPTH must go back too. Template 19.
model DeliveryNote {
  id             String         @id @default(cuid())
  no             String         @unique /// DNTH26110601
  serviceOrderId String
  serviceOrder   ServiceOrder   @relation(fields: [serviceOrderId], references: [id])
  status         DeliveryStatus @default(DRAFT)
  deliverOn      DateTime
  plantId        String?
  address        String?
  contactId      String?
  driverId       String?
  driver         Employee?      @relation(fields: [driverId], references: [id])
  vehicle        String?
  lines          Json /// [{kind: PO | RETURN, poLineNo?, description, assetCode?, partSku?, expected, delivered, source?}]
  mismatch       Json? /// what did not match when it was issued
  overrideReason String? /// MD approval to issue despite a mismatch
  overrideById   String?
  signedBy       String?
  signedAt       DateTime?
  signatureUrl   String?
  attachments    Json? /// archived with the DN: our signed copy (DELIVERY) and, when the customer insists on their own form, their delivery note (CUSTOMER_DN, optional)
  remark         String?
  shipping       Json? /// 国际贸易: the shipment behind this DNTH — packing per line (HS, origin, packages, kg), ports, vessel, B/L, export entry (src/lib/export.ts); prints as 34 Packing List
  createdAt      DateTime       @default(now())
}

model Document {
  id             String        @id @default(cuid())
  no             String        @unique
  type           DocType
  entityId       String
  entity         LegalEntity   @relation(fields: [entityId], references: [id])
  countryCode    String
  issuedAt       DateTime      @default(now())
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  createdById    String
  createdBy      Employee      @relation(fields: [createdById], references: [id])
  templateCode   String? /// 04 … 13 — which Word template renders it
  pdfUrl         String?
  voidedAt       DateTime?
  voidReason     String?

  @@index([type, issuedAt])
}

// ───────────────────────── Dashboards (built by people or by the AI assistant) ─────────────────────────

/// A dashboard is a JSON spec of widgets over the metric catalog in src/lib/metrics.ts — never raw SQL.
model Dashboard {
  id        String    @id @default(cuid())
  name      String
  ownerId   String?
  owner     Employee? @relation(fields: [ownerId], references: [id])
  spec      Json /// { widgets: [{ metric, chart, w, params }] }
  isShared  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ───────────── OPD · 加班 overtime (2026-11-09) ─────────────

/// LPA s.61–63: WORKDAY_OT 1.5×, HOLIDAY_WORK 1× (monthly staff), HOLIDAY_OT 3× the hourly wage (src/lib/overtime.ts).
enum OvertimeKind {
  WORKDAY_OT
  HOLIDAY_WORK
  HOLIDAY_OT
}

enum OvertimeStatus {
  PENDING /// waiting for the manager (or the MD)
  APPROVED /// counts at month end — actual hours when confirmed, otherwise the approved hours
  REJECTED
  CANCELLED
}

/// 加班申请 — the employee asks before the work (consent on each occasion), the manager or MD decides, the employee confirms
/// the actual hours afterwards. Month end counts every APPROVED request not yet paid (a late approval is paid next month).
model OvertimeRequest {
  id             String         @id @default(cuid())
  entityId       String
  employeeId     String
  employee       Employee       @relation("OvertimeOf", fields: [employeeId], references: [id])
  workDate       DateTime       @db.Date
  startTime      String /// "18:00" local time
  endTime        String /// "21:30"; at or before the start = past midnight
  breakMinutes   Int            @default(0)
  hours          Decimal        @db.Decimal(5, 2) /// requested / approved
  kind           OvertimeKind
  reason         String
  serviceOrderNo String? /// the QTTH the work was for, when there is one
  status         OvertimeStatus @default(PENDING)
  approverId     String?
  approver       Employee?      @relation("OvertimeApprover", fields: [approverId], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  actualStart    String?
  actualEnd      String?
  actualHours    Decimal?       @db.Decimal(5, 2) /// confirmed by the employee after the work; pays instead of `hours`
  confirmedAt    DateTime?
  payMonthId     String? /// set by the month-end close that paid it
  payMonth       OvertimeMonth? @relation(fields: [payMonthId], references: [id])
  createdById    String
  createdAt      DateTime       @default(now())

  @@index([employeeId, workDate])
  @@index([status, payMonthId])
}

/// 加班费月结 — the month-end result per legal entity, closed automatically on the 1st (Bangkok) or by the MD.
model OvertimeMonth {
  id          String            @id @default(cuid())
  entityId    String
  month       String /// "2026-11"
  closedAt    DateTime          @default(now())
  closedBy    String /// employee code, or "SYSTEM" for the automatic close
  totalHours  Decimal           @db.Decimal(8, 2)
  totalAmount Decimal           @db.Decimal(14, 2)
  lines       OvertimePayLine[]
  requests    OvertimeRequest[]

  @@unique([entityId, month])
}

/// One employee's overtime pay in a closed month. Rate basis and multipliers are copied so later changes never rewrite it.
model OvertimePayLine {
  id             String        @id @default(cuid())
  monthId        String
  month          OvertimeMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id])
  salaryRecordId String? /// the salary in force on the last day of the month
  baseSalary     Decimal       @db.Decimal(14, 2)
  hourlyRate     Decimal       @db.Decimal(10, 2) /// base ÷ 30 ÷ 8
  hours          Json /// {WORKDAY_OT, HOLIDAY_WORK, HOLIDAY_OT}
  multipliers    Json /// {WORKDAY_OT: 1.5, HOLIDAY_WORK: 1, HOLIDAY_OT: 3}
  amounts        Json
  totalHours     Decimal       @db.Decimal(6, 2)
  total          Decimal       @db.Decimal(14, 2)
  lateFrom       String[]      @default([]) /// earlier months whose late approvals are paid here
  missingSalary  Boolean       @default(false) /// no salary record: hours counted, amount 0 — the MD must add the salary and re-close

  @@unique([monthId, employeeId])
}

/// AI 动作 (朱总 2026-11-10): what the assistant did or proposes to do for a person. Most actions run at once
/// (status DONE, also in AuditLog as AI:<tool>); irreversible ones wait as PENDING until that person confirms.
model AiAction {
  id         String    @id @default(cuid())
  employeeId String
  tool       String
  input      Json
  summary    String
  status     String    @default("PENDING") /// PENDING | DONE | FAILED | CANCELLED
  result     Json?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@index([employeeId, status])
}

// ───────────────────────── 费用报销 / 培训 / 字典 / 权限 / Payroll (2026-11-11) ─────────────────────────

enum ExpenseStatus {
  PENDING /// waiting for the manager or the MD
  APPROVED /// to be reimbursed — with the next payroll, or by hand
  REJECTED
  PAID
  CANCELLED
}

/// 费用报销 — one receipt, one claim. The person photographs the receipt, the system reads it, the manager or MD decides.
/// A claim paid out of pocket (paidBy SELF) is reimbursed with the month's payroll unless finance pays it earlier.
model ExpenseClaim {
  id             String        @id @default(cuid())
  no             String?       @unique /// EXTH26111101 (朱总 2026-11-11)
  entityId       String
  employeeId     String
  employee       Employee      @relation("ExpenseOf", fields: [employeeId], references: [id])
  spentOn        DateTime      @db.Date
  category       String /// DictItem code of group expenseCategory
  description    String
  vendor         String?
  vendorTaxId    String?
  receiptNo      String? /// the receipt's or tax invoice's own number, verbatim
  currency       String        @default("THB")
  amount         Decimal       @db.Decimal(14, 2) /// total paid, VAT included
  vatAmount      Decimal?      @db.Decimal(14, 2) /// input VAT, only when the paper is a full tax invoice in the company's name
  paidBy         String        @default("SELF") /// SELF | PETTY_CASH | COMPANY
  serviceOrderNo String? /// the QTTH the cost belongs to, when there is one
  receipts       Json? /// [{name, url}]
  status         ExpenseStatus @default(PENDING)
  approverId     String?
  approver       Employee?     @relation("ExpenseApprover", fields: [approverId], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  paidAt         DateTime?
  paidRef        String? /// bank reference, or the payroll month that carried it
  payrollRunId   String?
  createdAt      DateTime      @default(now())

  @@index([employeeId, spentOn])
  @@index([status])
}

/// 培训记录 — what each person was trained in and with what result (the T of iMROT, inside the company).
model TrainingRecord {
  id            String    @id @default(cuid())
  entityId      String
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title         String
  kind          String /// DictItem code of group trainingKind
  provider      String?
  startedOn     DateTime  @db.Date
  endedOn       DateTime? @db.Date
  hours         Decimal?  @db.Decimal(6, 1)
  result        String    @default("ATTENDED") /// PLANNED | ATTENDED | PASSED | FAILED
  level         String? /// competency level reached, L1 … L4
  score         Decimal?  @db.Decimal(5, 1)
  certificateNo String?
  expiresAt     DateTime? @db.Date
  attachments   Json?
  note          String?
  createdById   String
  createdAt     DateTime  @default(now())

  @@index([employeeId, startedOn])
}

/// 数据字典 — the pick-lists people maintain themselves (expense categories, training kinds, units, positions …).
/// `system` rows are seeded and may be renamed or switched off, never deleted: records point at their codes.
model DictItem {
  id      String  @id @default(cuid())
  group   String
  code    String
  labelTh String
  labelZh String
  labelEn String
  sort    Int     @default(0)
  active  Boolean @default(true)
  system  Boolean @default(false)

  @@unique([group, code])
}

/// 权限管理 — a menu entry a role may not open. No row = allowed. The MD is never restricted.
model RoleMenu {
  role EmployeeRole
  key  String /// nav item key (src/lib/nav.ts)

  @@id([role, key])
}

enum PayrollStatus {
  DRAFT /// computed, still editable and re-computable
  APPROVED /// locked by the MD
  PAID
}

/// 月度工资 — one run per legal entity and month. Every figure a line was computed from is copied onto the line,
/// so later salary, law or policy changes never rewrite a month that was approved.
model PayrollRun {
  id             String        @id @default(cuid())
  entityId       String
  month          String /// "2026-11"
  status         PayrollStatus @default(DRAFT)
  policy         Json /// the performance bands and statutory figures used
  totals         Json /// {gross, sso, ssoEmployer, wht, net, employerCost, reimbursement}
  note           String?
  createdBy      String
  createdAt      DateTime      @default(now())
  computedAt     DateTime      @default(now())
  taxConfirmedBy String? /// 朱总 2026-11-11: withholding follows the accountant — approval waits for this
  taxConfirmedAt DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  paidAt         DateTime?
  lines          PayrollLine[]

  @@unique([entityId, month])
}

model PayrollLine {
  id               String     @id @default(cuid())
  runId            String
  run              PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id])
  salaryRecordId   String?
  baseSalary       Decimal    @db.Decimal(14, 2)
  allowances       Json /// [{name, amount, taxable}]
  allowanceTotal   Decimal    @db.Decimal(14, 2)
  overtime         Decimal    @default(0) @db.Decimal(14, 2)
  variablePay      Decimal    @default(0) @db.Decimal(14, 2) /// at 100 %
  perfScore        Decimal?   @db.Decimal(5, 1)
  perfFactor       Decimal    @default(1) @db.Decimal(6, 3)
  incentive        Decimal    @default(0) @db.Decimal(14, 2) /// variablePay × perfFactor
  perfBasis        String     @default("SCORE") /// SCORE (manager's monthly score) | TARGET (sales target achievement)
  achievement      Decimal?   @db.Decimal(8, 4) /// actual ÷ target of the month, for TARGET
  quarterlyPay     Decimal    @default(0) @db.Decimal(14, 2) /// three months at 100 %, only in a quarter's last month
  quarterAchieved  Decimal?   @db.Decimal(8, 4)
  quarterFactor    Decimal    @default(0) @db.Decimal(6, 3)
  quarterIncentive Decimal    @default(0) @db.Decimal(14, 2)
  bonus            Decimal    @default(0) @db.Decimal(14, 2) /// one-off, typed by the MD
  gross            Decimal    @db.Decimal(14, 2) /// taxable income of the month
  ssoBase          Decimal    @default(0) @db.Decimal(14, 2)
  ssoEmployee      Decimal    @default(0) @db.Decimal(14, 2)
  ssoEmployer      Decimal    @default(0) @db.Decimal(14, 2)
  pvdEmployee      Decimal    @default(0) @db.Decimal(14, 2)
  pvdEmployer      Decimal    @default(0) @db.Decimal(14, 2)
  wht              Decimal    @default(0) @db.Decimal(14, 2) /// ภ.ง.ด.1 withholding of the month
  whtManual        Boolean    @default(false) /// typed by the MD instead of computed
  whtDetail        Json? /// how the figure was reached
  otherDeduction   Decimal    @default(0) @db.Decimal(14, 2)
  reimbursement    Decimal    @default(0) @db.Decimal(14, 2) /// approved expense claims, not income
  net              Decimal    @db.Decimal(14, 2)
  employerCost     Decimal    @db.Decimal(14, 2)
  missing          String[]   @default([]) /// what the line could not find: SALARY, PERFORMANCE, OVERTIME_OPEN, TAX_ID, SSO_NO, BANK
  note             String?

  @@unique([runId, employeeId])
}

/// 销售目标 (朱总 2026-11-11): sales pay is 50 % base, 30 % on the month's target, 20 % on the quarter's.
/// Below 70 % of target the performance pay is 0; at 70 % it is 50 %; no cap above.
model SalesTarget {
  id           String   @id @default(cuid())
  entityId     String
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period       String /// "2026-11" for a month, "2026-Q4" for a quarter
  metric       String   @default("COLLECTED") /// COLLECTED (payments received) | INVOICED (tax invoices, ex VAT)
  target       Decimal  @db.Decimal(16, 2)
  actualManual Decimal? @db.Decimal(16, 2) /// typed by the MD when the system's figure is not the whole story
  note         String?
  setById      String
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, period])
}
