# Dev image for the Mac mini (OrbStack / Docker Desktop). The repo is bind-mounted at /app;
# node_modules and .next live in container volumes so the host's darwin binaries are untouched.
FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends libreoffice-writer fonts-noto-cjk openssl git procps \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=development PORT=3000 NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
CMD ["bash", "scripts/dev/container-entry.sh"]
