# Dev image for the Mac mini (OrbStack / Docker Desktop). The repo is bind-mounted at /app;
# node_modules and .next live in container volumes so the host's darwin binaries are untouched.
FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends libreoffice-writer fonts-noto-cjk fonts-texgyre curl ca-certificates openssl git procps poppler-utils \
 && rm -rf /var/lib/apt/lists/* \
 # DCiT fonts: Thai Sarabun (Google Fonts); Helvetica renders as TeX Gyre Heros (metric-compatible clone) when converting to PDF
 && mkdir -p /usr/share/fonts/truetype/sarabun \
 && for w in Regular Bold Italic BoldItalic; do curl -fsSL "https://github.com/google/fonts/raw/main/ofl/sarabun/Sarabun-$w.ttf" -o /usr/share/fonts/truetype/sarabun/Sarabun-$w.ttf; done \
 && fc-cache -f
WORKDIR /app
ENV NODE_ENV=development PORT=3000 NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
CMD ["bash", "scripts/dev/container-entry.sh"]
